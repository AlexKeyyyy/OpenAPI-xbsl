// Спецификация OpenAPI для СервисМагазина — пример полного описания API с помощью библиотеки AlexKey::OpenAPI.
//
// Схемы данных генератор строит сам по структурам МодельМагазина: типы, обязательность (T? — необязательно)
// и JSON-имена берутся из кода, здесь задаются только имена моделей и описания полей.
// Параметры пути описаны один раз в Параметры спецификации и подставляются во все операции по шаблону {имя}.

импорт AlexKey::OpenAPI::Основное

конст ТЕГ_ЗАКАЗЫ = "Заказы"
конст ТЕГ_КАТАЛОГ = "Каталог"
конст ТЕГ_КЛИЕНТЫ = "Клиенты"
конст РАЗМЕР_СТРАНИЦЫ_ПО_УМОЛЧАНИЮ = 20
конст МАКСИМАЛЬНЫЙ_РАЗМЕР_СТРАНИЦЫ = 100

@ВПодсистеме
метод Спецификация(): СпецификацияOpenApi
    знч Операции = ОперацииЗаказов()
    Операции.ДобавитьВсе(ОперацииКаталога())
    Операции.ДобавитьВсе(ОперацииКлиентов())
    возврат OpenApi.Спецификация(
        "API магазина",
        Проект.Версия.ВСтроку(),
        Описание = ОписаниеApi(),
        Теги = [
            OpenApi.Тег(ТЕГ_ЗАКАЗЫ, "Оформление заказов и их жизненный цикл"),
            OpenApi.Тег(ТЕГ_КАТАЛОГ, "Товары, цены и остатки"),
            OpenApi.Тег(ТЕГ_КЛИЕНТЫ, "Покупатели: физические лица и организации")
        ],
        Модели = Модели(),
        Параметры = [
            OpenApi.ПараметрПути("orderId", "Идентификатор заказа", OpenApi.Схема(Тип<Ууид>)),
            OpenApi.ПараметрПути("productId", "Идентификатор товара", OpenApi.Схема(Тип<Ууид>)),
            OpenApi.ПараметрПути("customerId", "Идентификатор клиента", OpenApi.Схема(Тип<Ууид>))
        ],
        Операции = Операции)
;

// Пределы page и pageSize совпадают с проверками СервисМагазина
@ВПодсистеме
метод РазмерСтраницыПоУмолчанию(): Число
    возврат РАЗМЕР_СТРАНИЦЫ_ПО_УМОЛЧАНИЮ
;

@ВПодсистеме
метод МаксимальныйРазмерСтраницы(): Число
    возврат МАКСИМАЛЬНЫЙ_РАЗМЕР_СТРАНИЦЫ
;

// Операции

@Локально
метод ОперацииЗаказов(): Массив<ОперацияOpenApi>
    возврат [
        OpenApi.Операция("GET", "/orders", "Список заказов",
            Тег = ТЕГ_ЗАКАЗЫ,
            Ид = "listOrders",
            Описание = "Заказы в порядке оформления с отбором по статусу и клиенту и постраничным выводом.",
            Параметры = [
                OpenApi.ПараметрЗапроса("status", "Отбор по статусу",
                    OpenApi.Схема(Тип<МодельМагазина.ВидСтатусаЗаказа>)),
                OpenApi.ПараметрЗапроса("customerId", "Отбор по клиенту", OpenApi.Схема(Тип<Ууид>)),
                OpenApi.ПараметрЗапроса("page", "Номер страницы, начиная с 1", ЦелоеЧисло(1, Умолчание = 1)),
                OpenApi.ПараметрЗапроса("pageSize", "Количество заказов на странице",
                    ЦелоеЧисло(1, МАКСИМАЛЬНЫЙ_РАЗМЕР_СТРАНИЦЫ, РАЗМЕР_СТРАНИЦЫ_ПО_УМОЛЧАНИЮ))
            ],
            Ответы = [
                OpenApi.Ответ(200, Тип<МодельМагазина.СтраницаЗаказов>),
                OpenApi.Ответ(400, "Недопустимое значение параметра запроса")
            ]),

        OpenApi.Операция("POST", "/orders", "Создать заказ",
            Тег = ТЕГ_ЗАКАЗЫ,
            Ид = "createOrder",
            Описание = "Цены строк берутся из каталога, сумма заказа рассчитывается сервером. "
                + "Количество — целое положительное и не больше остатка. "
                + "Организация оплачивает заказ только по счету (`invoice`). "
                + "Без `delivery` заказ оформляется на самовывоз.",
            Тело = OpenApi.Схема(Тип<МодельМагазина.НовыйЗаказ>),
            Ответы = [
                OpenApi.Ответ(201, Тип<МодельМагазина.Заказ>, "Заказ создан"),
                OpenApi.Ответ(400, "Тело запроса — не JSON заказа"),
                OpenApi.Ответ(422, "Заказ нарушает правила: нет клиента или товара, не хватает остатка, "
                    + "недопустимый способ оплаты")
            ]),

        OpenApi.Операция("GET", "/orders/{orderId}", "Получить заказ",
            Тег = ТЕГ_ЗАКАЗЫ,
            Ид = "getOrder",
            Ответы = [OpenApi.Ответ(200, Тип<МодельМагазина.Заказ>), OpenApi.Ответ(404, "Заказ не найден")]),

        OpenApi.Операция("PUT", "/orders/{orderId}/status", "Сменить статус заказа",
            Тег = ТЕГ_ЗАКАЗЫ,
            Ид = "changeOrderStatus",
            Описание = "Допустимые переходы: `new` → `confirmed` | `cancelled`, `confirmed` → `shipped` | `cancelled`, "
                + "`shipped` → `delivered`. Комментарий, если указан, заменяет комментарий заказа.",
            Тело = OpenApi.Схема(Тип<МодельМагазина.СменаСтатуса>),
            Ответы = [
                OpenApi.Ответ(200, Тип<МодельМагазина.Заказ>, "Статус изменен"),
                OpenApi.Ответ(400, "Тело запроса — не JSON смены статуса"),
                OpenApi.Ответ(404, "Заказ не найден"),
                OpenApi.Ответ(409, "Переход из текущего статуса не допускается")
            ]),

        OpenApi.Операция("DELETE", "/orders/{orderId}", "Удалить заказ",
            Тег = ТЕГ_ЗАКАЗЫ,
            Ид = "deleteOrder",
            Описание = "Удаляет только заказ в статусе `new`. Устарело: используйте смену статуса на `cancelled`.",
            Устарело = Истина,
            Ответы = [
                OpenApi.Ответ(204, "Заказ удален"),
                OpenApi.Ответ(404, "Заказ не найден"),
                OpenApi.Ответ(409, "Заказ уже в работе")
            ])
    ]
;

@Локально
метод ОперацииКаталога(): Массив<ОперацияOpenApi>
    знч Поиск = OpenApi.Уточнить(OpenApi.Схема(Тип<Строка>), <Строка, Объект?>{
            "minLength": 2,
            "examples": ["чайник", "MG-03"]
        })
    возврат [
        OpenApi.Операция("GET", "/products", "Поиск товаров",
            Тег = ТЕГ_КАТАЛОГ,
            Ид = "listProducts",
            Параметры = [
                OpenApi.ПараметрЗапроса("q", "Подстрока наименования или артикула без учета регистра", Поиск),
                OpenApi.ПараметрЗапроса("inStock", "Только товары в наличии", OpenApi.Схема(Тип<Булево>))
            ],
            Ответы = [
                OpenApi.Ответ(200, OpenApi.МассивИз(Тип<МодельМагазина.ТоварКаталога>)),
                OpenApi.Ответ(400, "Недопустимое значение параметра запроса")
            ]),

        OpenApi.Операция("GET", "/products/{productId}", "Получить товар",
            Тег = ТЕГ_КАТАЛОГ,
            Ид = "getProduct",
            Ответы = [OpenApi.Ответ(200, Тип<МодельМагазина.ТоварКаталога>), OpenApi.Ответ(404, "Товар не найден")])
    ]
;

@Локально
метод ОперацииКлиентов(): Массив<ОперацияOpenApi>
    возврат [
        OpenApi.Операция("GET", "/customers/{customerId}", "Получить клиента",
            Тег = ТЕГ_КЛИЕНТЫ,
            Ид = "getCustomer",
            Ответы = [OpenApi.Ответ(200, Тип<МодельМагазина.Клиент>), OpenApi.Ответ(404, "Клиент не найден")])
    ]
;

// Модели: имя схемы в components/schemas и описания полей по JSON-именам

@Локально
метод Модели(): Массив<МодельOpenApi>
    возврат [
        OpenApi.Модель(Тип<МодельМагазина.Заказ>, "Order", "Заказ покупателя", {
            "id": "Идентификатор заказа",
            "number": "Номер заказа для покупателя и поддержки",
            "createdAt": "Момент оформления (UTC)",
            "status": "Статус: new — новый, confirmed — подтвержден, shipped — отгружен, delivered — доставлен, "
                + "cancelled — отменен",
            "customerId": "Идентификатор клиента",
            "customerName": "Наименование клиента на момент оформления",
            "paymentMethod": "Способ оплаты: card — картой, cash — наличными, invoice — по счету",
            "delivery": "Адрес доставки; null — самовывоз",
            "lines": "Строки заказа",
            "total": "Сумма заказа",
            "currency": "Валюта (ISO 4217)",
            "comment": "Комментарий покупателя или менеджера"
        }),
        OpenApi.Модель(Тип<МодельМагазина.СтрокаЗаказа>, "OrderLine", "Строка заказа", {
            "productId": "Идентификатор товара",
            "sku": "Артикул",
            "name": "Наименование товара",
            "quantity": "Количество",
            "price": "Цена за единицу на момент оформления",
            "amount": "Сумма строки: price × quantity"
        }),
        OpenApi.Модель(Тип<МодельМагазина.АдресДоставки>, "DeliveryAddress", "Адрес доставки", {
            "postalCode": "Почтовый индекс",
            "city": "Город",
            "street": "Улица",
            "building": "Дом, корпус, строение",
            "apartment": "Квартира или офис"
        }),
        OpenApi.Модель(Тип<МодельМагазина.СтраницаЗаказов>, "OrderPage", "Страница списка заказов", {
            "items": "Заказы страницы",
            "page": "Номер страницы",
            "pageSize": "Размер страницы",
            "total": "Всего заказов по отбору"
        }),
        OpenApi.Модель(Тип<МодельМагазина.НовыйЗаказ>, "NewOrder", "Данные для создания заказа", {
            "customerId": "Идентификатор клиента",
            "paymentMethod": "Способ оплаты: card, cash или invoice",
            "delivery": "Адрес доставки; не указан — самовывоз",
            "lines": "Строки заказа, хотя бы одна",
            "comment": "Комментарий к заказу"
        }),
        OpenApi.Модель(Тип<МодельМагазина.НоваяСтрокаЗаказа>, "NewOrderLine", "Строка создаваемого заказа", {
            "productId": "Идентификатор товара из каталога",
            "quantity": "Количество, целое положительное"
        }),
        OpenApi.Модель(Тип<МодельМагазина.СменаСтатуса>, "OrderStatusChange", "Смена статуса заказа", {
            "status": "Новый статус",
            "comment": "Комментарий к смене статуса"
        }),
        OpenApi.Модель(Тип<МодельМагазина.ТоварКаталога>, "Product", "Товар каталога", {
            "id": "Идентификатор товара",
            "sku": "Артикул",
            "name": "Наименование",
            "price": "Цена за единицу",
            "unit": "Единица измерения",
            "stock": "Остаток на складе",
            "description": "Описание для витрины"
        }),
        OpenApi.Модель(Тип<МодельМагазина.Клиент>, "Customer", "Клиент магазина", {
            "id": "Идентификатор клиента",
            "kind": "Вид клиента: individual — физическое лицо, company — организация",
            "name": "ФИО или наименование организации",
            "email": "Адрес электронной почты",
            "phone": "Телефон в формате E.164",
            "inn": "ИНН организации"
        })
    ]
;

// Схемы

@Локально
метод ЦелоеЧисло(Минимум: Число, Максимум: Число? = Неопределено, Умолчание: Число? = Неопределено): СхемаOpenApi
    знч КлючевыеСлова = <Строка, Объект?>{"type": "integer", "minimum": Минимум}
    если Максимум != Неопределено
        КлючевыеСлова.Вставить("maximum", Максимум)
    ;
    если Умолчание != Неопределено
        КлючевыеСлова.Вставить("default", Умолчание)
    ;
    возврат OpenApi.Уточнить(OpenApi.Схема(Тип<Число>), КлючевыеСлова)
;

@Локально
метод ОписаниеApi(): Строка
    возврат "Демонстрационный REST API интернет-магазина: каталог, клиенты и заказы.\n\n"
        + "Спецификация построена библиотекой **AlexKey::OpenAPI** по коду приложения: схемы данных — "
        + "по структурам модуля `МодельМагазина`, операции — по описанию в модуле `ОписаниеApiМагазина`.\n\n"
        + "* Ошибки возвращаются в формате [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457) "
        + "(`application/problem+json`).\n"
        + "* Хранилища нет: создание, смена статуса и удаление проверяют правила и возвращают результат, "
        + "но не сохраняют его.\n"
        + "* Токен Bearer в демо не проверяется.\n\n"
        + "**Демо-данные:** клиенты `204350ad-59db-46cb-8ac0-7e3fa690c997` (физическое лицо) и "
        + "`c87e3db1-3cc9-437d-93e7-48991b247f81` (организация); товары — `GET /products`, заказы — `GET /orders`."
;
