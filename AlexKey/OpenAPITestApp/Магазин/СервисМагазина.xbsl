// /api/shop — демонстрационный REST API магазина, описанный спецификацией ОписаниеApiМагазина:
// /api/shop/docs — Swagger UI, /api/shop/docs/openapi.json — спецификация.
//
// Обработчики тонкие: разбор параметров → ДанныеМагазина → JSON-ответ. ИсключениеМагазина превращается
// в ответ application/problem+json с HTTP-кодом по виду ошибки — эти ответы и описаны в спецификации.

импорт AlexKey::OpenAPI::Основное
импорт AlexKey::OpenAPITestApp::Основное

// Документация

// Спецификация лежит в /docs/, поэтому сервер "../" по умолчанию указывает на корень сервиса /api/shop/
метод ДокументацияGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    знч Страница = OpenApi.СтраницаSwaggerUi(ОписаниеApiМагазина.Спецификация())
    ОбработкаЗапросов.Ответ(Запрос, 200, "text/html", Страница)
;

метод СпецификацияGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    ОбработкаЗапросов.Ответ(Запрос, 200, "application/json", OpenApi.ВJson(ОписаниеApiМагазина.Спецификация()))
;

// Заказы

метод ЗаказыGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        знч Найденные = ДанныеМагазина.Заказы(
            Статус = СтатусПараметра(Запрос),
            ИдКлиента = ИдПараметра(Запрос, "customerId"),
            Страница = ЦелоеПараметра(Запрос, "page", 1),
            РазмерСтраницы = ЦелоеПараметра(Запрос, "pageSize", ОписаниеApiМагазина.РазмерСтраницыПоУмолчанию(),
                ОписаниеApiМагазина.МаксимальныйРазмерСтраницы()))
        ОбработкаЗапросов.ОтветJson(Запрос, Найденные)
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

метод ЗаказыPOSTОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        знч Данные = ПрочитатьТело(Запрос, Тип<МодельМагазина.НовыйЗаказ>) как МодельМагазина.НовыйЗаказ
        ОбработкаЗапросов.ОтветJson(Запрос, ДанныеМагазина.СоздатьЗаказ(Данные), 201)
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

метод ЗаказGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        ОбработкаЗапросов.ОтветJson(Запрос, ДанныеМагазина.ЗаказПоИд(ИдПути(Запрос, "orderId")))
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

метод ЗаказDELETEОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        ДанныеМагазина.УдалитьЗаказ(ИдПути(Запрос, "orderId"))
        ОбработкаЗапросов.ОтветБезСодержимого(Запрос)
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

метод СтатусЗаказаPUTОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        знч Ид = ИдПути(Запрос, "orderId")
        знч Смена = ПрочитатьТело(Запрос, Тип<МодельМагазина.СменаСтатуса>) как МодельМагазина.СменаСтатуса
        ОбработкаЗапросов.ОтветJson(Запрос, ДанныеМагазина.СменитьСтатус(Ид, Смена))
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

// Каталог и клиенты

метод ТоварыGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        знч Поиск = Запрос.Параметры.ПолучитьПервый("q") ?? ""
        если Поиск.Длина() == 1
            выбросить НекорректныйПараметр("q", "строка поиска не короче 2 символов")
        ;
        знч Найденные = ДанныеМагазина.Товары(Поиск, ТолькоВНаличии = БулевоПараметра(Запрос, "inStock"))
        ОбработкаЗапросов.ОтветJson(Запрос, Найденные)
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

метод ТоварGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        ОбработкаЗапросов.ОтветJson(Запрос, ДанныеМагазина.ТоварПоИд(ИдПути(Запрос, "productId")))
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

метод КлиентGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        ОбработкаЗапросов.ОтветJson(Запрос, ДанныеМагазина.КлиентПоИд(ИдПути(Запрос, "customerId")))
    поймать Ошибка: ДанныеМагазина.ИсключениеМагазина
        ОтветитьОшибкой(Запрос, Ошибка)
    ;
;

// Ответ об ошибке

@Локально
метод ОтветитьОшибкой(Запрос: HttpСервисЗапрос, Ошибка: ДанныеМагазина.ИсключениеМагазина)
    знч КодыСтатуса = <ДанныеМагазина.ВидОшибкиМагазина, Число>{
        ДанныеМагазина.ВидОшибкиМагазина.НекорректныйЗапрос: 400,
        ДанныеМагазина.ВидОшибкиМагазина.НеНайдено: 404,
        ДанныеМагазина.ВидОшибкиМагазина.Конфликт: 409,
        ДанныеМагазина.ВидОшибкиМагазина.ОшибкаПроверки: 422
    }
    ОбработкаЗапросов.ОтветОшибка(Запрос, КодыСтатуса.Получить(Ошибка.Вид), Ошибка.Описание)
;

// Разбор запроса. Ошибка разбора — ИсключениеМагазина вида НекорректныйЗапрос (400),
// кроме идентификатора в пути: ресурса с таким адресом нет (404).

@Локально
метод ПрочитатьТело(Запрос: HttpСервисЗапрос, ТипДанных: Тип<Объект?>): Объект?
    попытка
        возврат СериализацияJson.ПрочитатьОбъект(Запрос.Тело.ПрочитатьКакСтроку(), ТипДанных)
    поймать Ошибка: ИсключениеЧтенияJson
        выбросить новый ДанныеМагазина.ИсключениеМагазина("Некорректный JSON: %{Ошибка.Описание}",
            ДанныеМагазина.ВидОшибкиМагазина.НекорректныйЗапрос)
    ;
;

@Локально
метод ИдПути(Запрос: HttpСервисЗапрос, Имя: Строка): Ууид
    знч Текст = Запрос.Параметры.ПолучитьПервый(Имя) ?? ""
    попытка
        возврат новый Ууид(Текст)
    поймать Ошибка: ИсключениеНедопустимыйФормат
        выбросить новый ДанныеМагазина.ИсключениеМагазина("Ресурс '%Текст' не найден: ожидается UUID",
            ДанныеМагазина.ВидОшибкиМагазина.НеНайдено)
    ;
;

// Необязательные параметры запроса: не указан — Неопределено (для Булево — Ложь)

@Локально
метод ИдПараметра(Запрос: HttpСервисЗапрос, Имя: Строка): Ууид?
    знч Текст = Запрос.Параметры.ПолучитьПервый(Имя)
    если Текст == Неопределено
        возврат Неопределено
    ;
    попытка
        возврат новый Ууид(Текст)
    поймать Ошибка: ИсключениеНедопустимыйФормат
        выбросить НекорректныйПараметр(Имя, "ожидается UUID")
    ;
;

@Локально
метод СтатусПараметра(Запрос: HttpСервисЗапрос): МодельМагазина.ВидСтатусаЗаказа?
    знч Текст = Запрос.Параметры.ПолучитьПервый("status")
    если Текст == Неопределено
        возврат Неопределено
    ;
    знч Статус = МодельМагазина.СтатусПоКоду(Текст)
    если Статус == Неопределено
        выбросить НекорректныйПараметр("status", "неизвестный статус '%Текст'")
    ;
    возврат Статус
;

// Целое не меньше 1 и не больше Максимум, если он задан; параметр не указан — Умолчание
@Локально
метод ЦелоеПараметра(
        Запрос: HttpСервисЗапрос,
        Имя: Строка,
        Умолчание: Число,
        Максимум: Число? = Неопределено
    ): Число

    знч Текст = Запрос.Параметры.ПолучитьПервый(Имя)
    если Текст == Неопределено
        возврат Умолчание
    ;
    знч Значение = ЧислоПараметра(Имя, Текст)
    если Значение < 1 или Значение != Значение.ЦелаяЧасть()
        выбросить НекорректныйПараметр(Имя, "ожидается целое число не меньше 1")
    ;
    если Максимум != Неопределено и Значение > Максимум!
        выбросить НекорректныйПараметр(Имя, "ожидается число не больше %Максимум")
    ;
    возврат Значение
;

@Локально
метод ЧислоПараметра(Имя: Строка, Текст: Строка): Число
    попытка
        возврат новый Число(Текст)
    поймать Ошибка: ИсключениеНедопустимыйФормат
        выбросить НекорректныйПараметр(Имя, "ожидается число")
    ;
;

@Локально
метод БулевоПараметра(Запрос: HttpСервисЗапрос, Имя: Строка): Булево
    знч Текст = Запрос.Параметры.ПолучитьПервый(Имя) ?? "false"
    если Текст != "true" и Текст != "false"
        выбросить НекорректныйПараметр(Имя, "ожидается true или false")
    ;
    возврат Текст == "true"
;

@Локально
метод НекорректныйПараметр(Имя: Строка, Причина: Строка): ДанныеМагазина.ИсключениеМагазина
    возврат новый ДанныеМагазина.ИсключениеМагазина("Параметр '%Имя': %Причина",
        ДанныеМагазина.ВидОшибкиМагазина.НекорректныйЗапрос)
;
