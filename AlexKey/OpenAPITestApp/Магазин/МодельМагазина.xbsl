// Модель данных API магазина: структуры и перечисления, которые записываются в JSON и описываются в OpenAPI.
//
// Типы объявлены в модуле, а не элементами Структура/Перечисление: JsonЭлементПеречисления задается только
// у перечисления, объявленного в модуле, а значения статусов в API - английские коды ("new", "shipped").
// Генератор OpenAPI создает экземпляр модели без аргументов, поэтому у полей нет «обз»: поле без значения
// инициализации получает значение по умолчанию своего типа, а поле-структура объявляется как T?.

// Перечисления

@ВПодсистеме
перечисление ВидСтатусаЗаказа
    @JsonЭлементПеречисления("new")
    Новый умолчание,
    @JsonЭлементПеречисления("confirmed")
    Подтвержден,
    @JsonЭлементПеречисления("shipped")
    Отгружен,
    @JsonЭлементПеречисления("delivered")
    Доставлен,
    @JsonЭлементПеречисления("cancelled")
    Отменен
;

@ВПодсистеме
перечисление ВидКлиента
    @JsonЭлементПеречисления("individual")
    ФизическоеЛицо умолчание,
    @JsonЭлементПеречисления("company")
    Организация
;

@ВПодсистеме
перечисление ВидОплаты
    @JsonЭлементПеречисления("card")
    Карта умолчание,
    @JsonЭлементПеречисления("cash")
    Наличные,
    @JsonЭлементПеречисления("invoice")
    ПоСчету
;

// Каталог и клиенты

@ВПодсистеме
структура ТоварКаталога
    @JsonСвойство("id")
    пер Ид: Ууид
    @JsonСвойство("sku")
    пер Артикул: Строка
    @JsonСвойство("name")
    пер Наименование: Строка
    @JsonСвойство("price")
    пер Цена: Число
    @JsonСвойство("unit")
    пер ЕдиницаИзмерения: Строка
    @JsonСвойство("stock")
    пер Остаток: Число
    @JsonСвойство("description")
    пер Описание: Строка?
;

@ВПодсистеме
структура Клиент
    @JsonСвойство("id")
    пер Ид: Ууид
    @JsonСвойство("kind")
    пер Вид: ВидКлиента
    @JsonСвойство("name")
    пер Наименование: Строка
    @JsonСвойство("email")
    пер Email: Строка
    @JsonСвойство("phone")
    пер Телефон: Строка?
    @JsonСвойство("inn")
    пер Инн: Строка?
;

// Заказы

@ВПодсистеме
структура АдресДоставки
    @JsonСвойство("postalCode")
    пер Индекс: Строка
    @JsonСвойство("city")
    пер Город: Строка
    @JsonСвойство("street")
    пер Улица: Строка
    @JsonСвойство("building")
    пер Дом: Строка
    @JsonСвойство("apartment")
    пер Квартира: Строка?
;

@ВПодсистеме
структура СтрокаЗаказа
    @JsonСвойство("productId")
    пер ИдТовара: Ууид
    @JsonСвойство("sku")
    пер Артикул: Строка
    @JsonСвойство("name")
    пер Наименование: Строка
    @JsonСвойство("quantity")
    пер Количество: Число
    @JsonСвойство("price")
    пер Цена: Число
    @JsonСвойство("amount")
    пер Сумма: Число
;

@ВПодсистеме
структура Заказ
    @JsonСвойство("id")
    пер Ид: Ууид
    @JsonСвойство("number")
    пер Номер: Строка
    @JsonСвойство("createdAt")
    пер Создан: Момент
    @JsonСвойство("status")
    пер Статус: ВидСтатусаЗаказа
    @JsonСвойство("customerId")
    пер ИдКлиента: Ууид
    @JsonСвойство("customerName")
    пер НаименованиеКлиента: Строка
    @JsonСвойство("paymentMethod")
    пер Оплата: ВидОплаты
    @JsonСвойство("delivery")
    пер Доставка: АдресДоставки?
    @JsonСвойство("lines")
    пер Строки: Массив<СтрокаЗаказа>
    @JsonСвойство("total")
    пер Итого: Число
    @JsonСвойство("currency")
    пер Валюта: Строка
    @JsonСвойство("comment")
    пер Комментарий: Строка?
;

@ВПодсистеме
структура СтраницаЗаказов
    @JsonСвойство("items")
    пер Элементы: Массив<Заказ>
    @JsonСвойство("page")
    пер Страница: Число
    @JsonСвойство("pageSize")
    пер РазмерСтраницы: Число
    @JsonСвойство("total")
    пер Всего: Число
;

// Тела запросов

@ВПодсистеме
структура НоваяСтрокаЗаказа
    @JsonСвойство("productId")
    пер ИдТовара: Ууид
    @JsonСвойство("quantity")
    пер Количество: Число
;

@ВПодсистеме
структура НовыйЗаказ
    @JsonСвойство("customerId")
    пер ИдКлиента: Ууид
    @JsonСвойство("paymentMethod")
    пер Оплата: ВидОплаты
    @JsonСвойство("delivery")
    пер Доставка: АдресДоставки?
    @JsonСвойство("lines")
    пер Строки: Массив<НоваяСтрокаЗаказа>
    @JsonСвойство("comment")
    пер Комментарий: Строка?
;

@ВПодсистеме
структура СменаСтатуса
    @JsonСвойство("status")
    пер Статус: ВидСтатусаЗаказа
    @JsonСвойство("comment")
    пер Комментарий: Строка?
;

// Жизненный цикл заказа: new → confirmed → shipped → delivered; отменить можно до отгрузки
@ВПодсистеме
метод СледующиеСтатусы(Статус: ВидСтатусаЗаказа): Множество<ВидСтатусаЗаказа>
    знч Переходы = <ВидСтатусаЗаказа, Множество<ВидСтатусаЗаказа>>{
        ВидСтатусаЗаказа.Новый: {ВидСтатусаЗаказа.Подтвержден, ВидСтатусаЗаказа.Отменен},
        ВидСтатусаЗаказа.Подтвержден: {ВидСтатусаЗаказа.Отгружен, ВидСтатусаЗаказа.Отменен},
        ВидСтатусаЗаказа.Отгружен: {ВидСтатусаЗаказа.Доставлен}
    }
    возврат Переходы.ПолучитьИлиНеопределено(Статус) ?? <ВидСтатусаЗаказа>{}
;

// Статус по коду из JSON ("new", "shipped"); Неопределено - такого кода нет.
@ВПодсистеме
метод СтатусПоКоду(Код: Строка): ВидСтатусаЗаказа?
    возврат [
        ВидСтатусаЗаказа.Новый,
        ВидСтатусаЗаказа.Подтвержден,
        ВидСтатусаЗаказа.Отгружен,
        ВидСтатусаЗаказа.Доставлен,
        ВидСтатусаЗаказа.Отменен
    ].Фильтровать(Статус -> КодСтатуса(Статус) == Код).ПервыйИлиНеопределено()
;

@ВПодсистеме
метод КодСтатуса(Статус: ВидСтатусаЗаказа): Строка
    знч Json = СериализацияJson.ЗаписатьОбъект(<Строка, ВидСтатусаЗаказа>{"status": Статус})
    возврат СериализацияJson.ПрочитатьОбъект(Json, Тип<Соответствие<Строка, Строка>>).Получить("status")
;
