// Данные и правила демонстрационного магазина.
//
// Хранилища нет: каталог, клиенты и заказы — фиксированные списки. Создание, смена статуса и удаление заказа
// проверяют правила и возвращают результат, но ничего не сохраняют. В приложении здесь были бы запросы
// к справочникам и документам и запись в транзакции.
// Нарушение правил — ИсключениеМагазина; HTTP-код ответа по виду ошибки выбирает СервисМагазина.

конст ВАЛЮТА = "RUB"
конст ЧАСОВОЙ_ПОЯС = "Europe/Moscow"
конст ПЕРВЫЙ_НОМЕР_ЗАКАЗА = 1001

@ВПодсистеме
перечисление ВидОшибкиМагазина
    НекорректныйЗапрос умолчание,
    НеНайдено,
    Конфликт,
    ОшибкаПроверки
;

@ВПодсистеме
исключение ИсключениеМагазина
    обз пер Вид: ВидОшибкиМагазина
;

// Каталог и клиенты

// Поиск — подстрока наименования или артикула без учета регистра
@ВПодсистеме
метод Товары(Поиск: Строка = "", ТолькоВНаличии: Булево = Ложь): Массив<МодельМагазина.ТоварКаталога>
    возврат Каталог()
        .Фильтровать(Позиция -> СоответствуетПоиску(Позиция, Поиск))
        .Фильтровать(Позиция -> не ТолькоВНаличии или Позиция.Остаток > 0)
;

@ВПодсистеме
метод ТоварПоИд(Ид: Ууид): МодельМагазина.ТоварКаталога
    знч Найденный = Каталог().Фильтровать(Позиция -> Позиция.Ид == Ид).ПервыйИлиНеопределено()
    если Найденный == Неопределено
        выбросить новый ИсключениеМагазина("Товар '%Ид' не найден", ВидОшибкиМагазина.НеНайдено)
    ;
    возврат Найденный
;

@ВПодсистеме
метод КлиентПоИд(Ид: Ууид): МодельМагазина.Клиент
    знч Найденный = Клиенты().Фильтровать(Покупатель -> Покупатель.Ид == Ид).ПервыйИлиНеопределено()
    если Найденный == Неопределено
        выбросить новый ИсключениеМагазина("Клиент '%Ид' не найден", ВидОшибкиМагазина.НеНайдено)
    ;
    возврат Найденный
;

// Заказы

// Статус и ИдКлиента — необязательные отборы; Страница — с 1
@ВПодсистеме
метод Заказы(
        Статус: МодельМагазина.ВидСтатусаЗаказа?,
        ИдКлиента: Ууид?,
        Страница: Число,
        РазмерСтраницы: Число
    ): МодельМагазина.СтраницаЗаказов

    знч Найденные = ВсеЗаказы()
        .Фильтровать(Элемент -> Статус == Неопределено или Элемент.Статус == Статус)
        .Фильтровать(Элемент -> ИдКлиента == Неопределено или Элемент.ИдКлиента == ИдКлиента)
    знч Начало = (Страница - 1) * РазмерСтраницы
    знч Конец = Начало + РазмерСтраницы
    знч ЗаказыСтраницы = Начало >= Найденные.Размер()
        ? <МодельМагазина.Заказ>[]
        : Найденные.ПодМассив(Начало, Конец > Найденные.Размер() ? Найденные.Размер() : Конец)
    возврат новый МодельМагазина.СтраницаЗаказов(
        Элементы = ЗаказыСтраницы,
        Страница = Страница,
        РазмерСтраницы = РазмерСтраницы,
        Всего = Найденные.Размер())
;

@ВПодсистеме
метод ЗаказПоИд(Ид: Ууид): МодельМагазина.Заказ
    знч Найденный = ВсеЗаказы().Фильтровать(Элемент -> Элемент.Ид == Ид).ПервыйИлиНеопределено()
    если Найденный == Неопределено
        выбросить новый ИсключениеМагазина("Заказ '%Ид' не найден", ВидОшибкиМагазина.НеНайдено)
    ;
    возврат Найденный
;

// Цены берутся из каталога, остаток проверяется по каждой строке.
// Организация оплачивает заказ только по счету.
@ВПодсистеме
метод СоздатьЗаказ(Данные: МодельМагазина.НовыйЗаказ): МодельМагазина.Заказ
    знч Покупатель = Клиенты().Фильтровать(Элемент -> Элемент.Ид == Данные.ИдКлиента).ПервыйИлиНеопределено()
    если Покупатель == Неопределено
        выбросить ОшибкаПроверки("Клиент '%{Данные.ИдКлиента}' не найден")
    ;
    если Покупатель.Вид == МодельМагазина.ВидКлиента.Организация и Данные.Оплата != МодельМагазина.ВидОплаты.ПоСчету
        выбросить ОшибкаПроверки("Организация оплачивает заказ только по счету (paymentMethod = invoice)")
    ;
    если Данные.Строки.Пусто()
        выбросить ОшибкаПроверки("В заказе нет строк")
    ;

    знч СтрокиЗаказа = Данные.Строки.Преобразовать(Позиция -> СтрокаНовогоЗаказа(Позиция))
    возврат новый МодельМагазина.Заказ(
        Ид = новый Ууид(),
        Номер = НомерЗаказа(ВсеЗаказы().Размер()),
        Создан = Момент.Сейчас(),
        Статус = МодельМагазина.ВидСтатусаЗаказа.Новый,
        ИдКлиента = Покупатель.Ид,
        НаименованиеКлиента = Покупатель.Наименование,
        Оплата = Данные.Оплата,
        Доставка = Данные.Доставка,
        Строки = СтрокиЗаказа,
        Итого = СтрокиЗаказа.Преобразовать(Позиция -> Позиция.Сумма).Сумма(),
        Валюта = ВАЛЮТА,
        Комментарий = Данные.Комментарий)
;

// Переход — по жизненному циклу МодельМагазина.СледующиеСтатусы, иначе конфликт
@ВПодсистеме
метод СменитьСтатус(Ид: Ууид, Смена: МодельМагазина.СменаСтатуса): МодельМагазина.Заказ
    знч Изменяемый = ЗаказПоИд(Ид)
    если не МодельМагазина.СледующиеСтатусы(Изменяемый.Статус).Содержит(Смена.Статус)
        выбросить новый ИсключениеМагазина(
            "Заказ %{Изменяемый.Номер} нельзя перевести из статуса "
                + "'%{МодельМагазина.КодСтатуса(Изменяемый.Статус)}' в '%{МодельМагазина.КодСтатуса(Смена.Статус)}'",
            ВидОшибкиМагазина.Конфликт)
    ;
    Изменяемый.Статус = Смена.Статус
    Изменяемый.Комментарий = Смена.Комментарий ?? Изменяемый.Комментарий
    возврат Изменяемый
;

// Удалить можно только новый заказ; остальные отменяются сменой статуса
@ВПодсистеме
метод УдалитьЗаказ(Ид: Ууид)
    знч Удаляемый = ЗаказПоИд(Ид)
    если Удаляемый.Статус != МодельМагазина.ВидСтатусаЗаказа.Новый
        выбросить новый ИсключениеМагазина(
            "Заказ %{Удаляемый.Номер} уже в работе: отмените его сменой статуса на 'cancelled'",
            ВидОшибкиМагазина.Конфликт)
    ;
;

// Правила

@Локально
метод СтрокаНовогоЗаказа(Позиция: МодельМагазина.НоваяСтрокаЗаказа): МодельМагазина.СтрокаЗаказа
    если Позиция.Количество <= 0 или Позиция.Количество != Позиция.Количество.ЦелаяЧасть()
        выбросить ОшибкаПроверки("Количество должно быть целым положительным числом: %{Позиция.Количество}")
    ;
    знч Найденный = Каталог().Фильтровать(Элемент -> Элемент.Ид == Позиция.ИдТовара).ПервыйИлиНеопределено()
    если Найденный == Неопределено
        выбросить ОшибкаПроверки("Товар '%{Позиция.ИдТовара}' не найден в каталоге")
    ;
    если Найденный.Остаток < Позиция.Количество
        выбросить ОшибкаПроверки("Недостаточно товара '%{Найденный.Наименование}': заказано %{Позиция.Количество}, "
            + "в наличии %{Найденный.Остаток}")
    ;
    возврат СтрокаЗаказа(Найденный, Позиция.Количество)
;

@Локально
метод ОшибкаПроверки(Описание: Строка): ИсключениеМагазина
    возврат новый ИсключениеМагазина(Описание, ВидОшибкиМагазина.ОшибкаПроверки)
;

@Локально
метод СоответствуетПоиску(Позиция: МодельМагазина.ТоварКаталога, Поиск: Строка): Булево
    возврат Позиция.Наименование.Содержит(Поиск, ИгнорироватьРегистр = Истина)
        или Позиция.Артикул.Содержит(Поиск, ИгнорироватьРегистр = Истина)
;

@Локально
метод НомерЗаказа(Индекс: Число): Строка
    возврат "SO-%{ПЕРВЫЙ_НОМЕР_ЗАКАЗА + Индекс}"
;

@Локально
метод СтрокаЗаказа(Позиция: МодельМагазина.ТоварКаталога, Количество: Число): МодельМагазина.СтрокаЗаказа
    возврат новый МодельМагазина.СтрокаЗаказа(
        ИдТовара = Позиция.Ид,
        Артикул = Позиция.Артикул,
        Наименование = Позиция.Наименование,
        Количество = Количество,
        Цена = Позиция.Цена,
        Сумма = Позиция.Цена * Количество)
;

// Демонстрационные данные

@Локально
метод Каталог(): Массив<МодельМагазина.ТоварКаталога>
    возврат [
        новый МодельМагазина.ТоварКаталога(
