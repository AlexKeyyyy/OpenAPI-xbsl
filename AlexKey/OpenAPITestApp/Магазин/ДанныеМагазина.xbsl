;

@Локально
метод Клиенты(): Массив<МодельМагазина.Клиент>
    возврат [
        новый МодельМагазина.Клиент(
            Ид = Ууид{204350ad-59db-46cb-8ac0-7e3fa690c997},
            Вид = МодельМагазина.ВидКлиента.ФизическоеЛицо,
            Наименование = "Анна Смирнова",
            Email = "anna.smirnova@example.com",
            Телефон = "+79000000001"),
        новый МодельМагазина.Клиент(
            Ид = Ууид{c87e3db1-3cc9-437d-93e7-48991b247f81},
            Вид = МодельМагазина.ВидКлиента.Организация,
            Наименование = "ООО «Ромашка»",
            Email = "zakaz@romashka.example.com",
            Телефон = "+74950000002",
            Инн = "7701234567"),
        новый МодельМагазина.Клиент(
            Ид = Ууид{4f97c3e5-cc68-4a1b-87f7-e983e050008c},
            Вид = МодельМагазина.ВидКлиента.ФизическоеЛицо,
            Наименование = "Иван Петров",
            Email = "ivan.petrov@example.com")
    ]
;

@Локально
метод ВсеЗаказы(): Массив<МодельМагазина.Заказ>
    знч Смирнова = КлиентДемо("anna.smirnova@example.com")
    знч Ромашка = КлиентДемо("zakaz@romashka.example.com")
    знч Петров = КлиентДемо("ivan.petrov@example.com")
    знч АдресСмирновой = новый МодельМагазина.АдресДоставки(
        Индекс = "190000",
        Город = "Санкт-Петербург",
        Улица = "Невский проспект",
        Дом = "1",
        Квартира = "15")
    знч АдресРомашки = новый МодельМагазина.АдресДоставки(
        Индекс = "101000",
        Город = "Москва",
        Улица = "Мясницкая",
        Дом = "10, стр. 2")
    возврат [
        ЗаказДемо(Ууид{089a0048-d02d-4a3a-8e7c-8a94048d7fcb}, 0, ДатаВремя{2024-05-14T10:15:00},
            МодельМагазина.ВидСтатусаЗаказа.Доставлен, Смирнова, МодельМагазина.ВидОплаты.Карта, АдресСмирновой,
            [СтрокаЗаказа(ТоварДемо("KT-17"), 1), СтрокаЗаказа(ТоварДемо("MG-03"), 2)]),
        ЗаказДемо(Ууид{338265ab-d4ed-4f5f-9038-f79f7dc1b9f8}, 1, ДатаВремя{2024-05-20T16:40:00},
            МодельМагазина.ВидСтатусаЗаказа.Отгружен, Ромашка, МодельМагазина.ВидОплаты.ПоСчету, АдресРомашки,
            [СтрокаЗаказа(ТоварДемо("MG-03"), 24), СтрокаЗаказа(ТоварДемо("TW-50"), 10)]),
        ЗаказДемо(Ууид{392fe80f-b5f7-4b27-92f7-7fc6ac586883}, 2, ДатаВремя{2024-06-02T09:05:00},
            МодельМагазина.ВидСтатусаЗаказа.Подтвержден, Петров, МодельМагазина.ВидОплаты.Наличные, Неопределено,
            [СтрокаЗаказа(ТоварДемо("FL-10"), 2)], "Самовывоз после 18:00"),
        ЗаказДемо(Ууид{10b6471b-01b7-4db4-abbc-abeaf79c2662}, 3, ДатаВремя{2024-06-03T12:30:00},
            МодельМагазина.ВидСтатусаЗаказа.Новый, Смирнова, МодельМагазина.ВидОплаты.Карта, АдресСмирновой,
            [СтрокаЗаказа(ТоварДемо("TW-50"), 2)])
    ]
;

@Локально
метод ЗаказДемо(
        Ид: Ууид,
        Индекс: Число,
        Создан: ДатаВремя,
        Статус: МодельМагазина.ВидСтатусаЗаказа,
        Покупатель: МодельМагазина.Клиент,
        Оплата: МодельМагазина.ВидОплаты,
        Доставка: МодельМагазина.АдресДоставки?,
        СтрокиЗаказа: Массив<МодельМагазина.СтрокаЗаказа>,
        Комментарий: Строка? = Неопределено
    ): МодельМагазина.Заказ

    возврат новый МодельМагазина.Заказ(
        Ид = Ид,
        Номер = НомерЗаказа(Индекс),
        Создан = Создан.ВМомент(новый ЧасовойПояс(ЧАСОВОЙ_ПОЯС)),
        Статус = Статус,
        ИдКлиента = Покупатель.Ид,
        НаименованиеКлиента = Покупатель.Наименование,
        Оплата = Оплата,
        Доставка = Доставка,
        Строки = СтрокиЗаказа,
        Итого = СтрокиЗаказа.Преобразовать(Позиция -> Позиция.Сумма).Сумма(),
        Валюта = ВАЛЮТА,
        Комментарий = Комментарий)
;

@Локально
метод ТоварДемо(Артикул: Строка): МодельМагазина.ТоварКаталога
    возврат Каталог().Фильтровать(Позиция -> Позиция.Артикул == Артикул).Единственный()
;

@Локально
метод КлиентДемо(Email: Строка): МодельМагазина.Клиент
    возврат Клиенты().Фильтровать(Покупатель -> Покупатель.Email == Email).Единственный()
;
