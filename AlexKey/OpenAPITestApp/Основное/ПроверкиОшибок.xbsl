// Негативные проверки генератора: каждое ошибочное описание должно остановить построение спецификации
// исключением OpenApi.ИсключениеОписания с понятным текстом. Последний случай - контрольный, без ошибки.

импорт AlexKey::OpenAPI::Основное

структура СлучайОшибки
    обз знч Имя: Строка
    обз знч Ожидается: Строка
    обз знч Спецификация: СпецификацияOpenApi
;

структура РезультатПроверки
    @JsonСвойство("case")
    обз знч Случай: Строка
    @JsonСвойство("passed")
    обз знч Пройден: Булево
    @JsonСвойство("expected")
    обз знч Ожидается: Строка
    @JsonСвойство("actual")
    обз знч Получено: Строка
;

@ВПодсистеме
метод Выполнить(): Соответствие<Строка, Объект?>
    знч Результаты = Случаи().Преобразовать(Случай -> Проверить(Случай))
    знч Пройдено = Результаты.Фильтровать(Результат -> Результат.Пройден).Размер()
    возврат {
        "passed": Пройдено,
        "failed": Результаты.Размер() - Пройдено,
        "results": Результаты
    }
;

@Локально
метод Проверить(Случай: СлучайОшибки): РезультатПроверки
    пер Получено = ""
    попытка
        OpenApi.ВJson(Случай.Спецификация)
    поймать Ошибка: OpenApi.ИсключениеОписания
        Получено = Ошибка.Описание
    ;
    знч Пройден = Случай.Ожидается.Пусто() ? Получено.Пусто() : Получено.Содержит(Случай.Ожидается)
    возврат новый РезультатПроверки(Случай.Имя, Пройден, Случай.Ожидается, Получено)
;

@Локально
метод Случаи(): Массив<СлучайОшибки>
    знч Ответы = [OpenApi.Ответ(204)]
    возврат [
        // Метод приводится к нижнему регистру, поэтому GET и get - одна операция
        новый СлучайОшибки("duplicate-operation", "описана несколько раз", СпецификацияСлучая([
            OpenApi.Операция("GET", "/a", "Первая", Ответы),
            OpenApi.Операция("get", "/a", "Вторая", Ответы)
        ])),
        новый СлучайОшибки("duplicate-operation-id", "Ид операции 'op' уже занят", СпецификацияСлучая([
            OpenApi.Операция("GET", "/a", "Первая", Ответы, Ид = "op"),
            OpenApi.Операция("GET", "/b", "Вторая", Ответы, Ид = "op")
        ])),
        новый СлучайОшибки("invalid-method", "Недопустимый HTTP-метод", СпецификацияСлучая([
            OpenApi.Операция("FETCH", "/a", "Метод не из OpenAPI", Ответы)
        ])),
        новый СлучайОшибки("unknown-path-parameter", "отсутствует в шаблоне", СпецификацияСлучая([
            OpenApi.Операция("GET", "/a/{id}", "Параметр не из шаблона", Ответы,
                Параметры = [OpenApi.ПараметрПути("other")])
        ])),
        новый СлучайОшибки("spec-query-parameter", "должен быть параметром пути", СпецификацияСлучая(
            [OpenApi.Операция("GET", "/a", "Операция", Ответы)],
            Параметры = [OpenApi.ПараметрЗапроса("q")])),
        новый СлучайОшибки("duplicate-model-name", "'Same' уже занято", СпецификацияСлучая(
            [OpenApi.Операция("GET", "/a", "Операция", Ответы)],
            Модели = [OpenApi.Модель(Тип<Узел>, "Same"), OpenApi.Модель(Тип<Книга>, "Same")])),
        новый СлучайОшибки("reserved-model-name", "'Problem' уже занято", СпецификацияСлучая(
            [OpenApi.Операция("GET", "/a", "Операция", Ответы)],
            Модели = [OpenApi.Модель(Тип<Узел>, "Problem")])),
        новый СлучайОшибки("duplicate-model-type", "несколько раз", СпецификацияСлучая(
            [OpenApi.Операция("GET", "/a", "Операция", Ответы)],
            Модели = [OpenApi.Модель(Тип<Узел>, "First"), OpenApi.Модель(Тип<Узел>, "Second")])),
        // Составной Тип<Строка?> не проверяется: компилятор не допускает составное значение типа
        новый СлучайОшибки("undefined-type", "не поддерживается", СпецификацияСлучая([
            OpenApi.Операция("GET", "/a", "Неопределено в Схема()", [OpenApi.Ответ(200, Тип<Неопределено>)])
        ])),
        новый СлучайОшибки("undeclared-model", "не объявлен моделью", СпецификацияСлучая([
            OpenApi.Операция("GET", "/a", "Структура без модели", [OpenApi.Ответ(200, Тип<Узел>)])
        ])),
        новый СлучайОшибки("model-without-defaults", "Не удалось создать экземпляр", СпецификацияСлучая(
            [OpenApi.Операция("GET", "/a", "Модель с обязательным полем", [OpenApi.Ответ(200, Тип<БезУмолчаний>)])],
            Модели = [OpenApi.Модель(Тип<БезУмолчаний>, "NoDefaults")])),
        новый СлучайОшибки("valid", "", СпецификацияСлучая(
            [OpenApi.Операция("GET", "/a/{id}", "Корректная операция",
                [OpenApi.Ответ(200, Тип<Узел>), OpenApi.Ответ(404)])],
            Модели = [OpenApi.Модель(Тип<Узел>, "Node")]))
    ]
;

@Локально
метод СпецификацияСлучая(
        Операции: Массив<ОперацияOpenApi>,
        Модели: Массив<МодельOpenApi>? = Неопределено,
        Параметры: Массив<ПараметрOpenApi>? = Неопределено
    ): СпецификацияOpenApi

    возврат OpenApi.Спецификация("Проверка", "1.0", Операции, Модели = Модели, Параметры = Параметры)
;
