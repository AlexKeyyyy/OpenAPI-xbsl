// /api/docs - оглавление тестового приложения: пример API магазина, сценарии и негативные проверки.
// /api/docs/{scenario} - Swagger UI сценария, /api/docs/{scenario}/openapi.json - спецификация,
// /api/docs/{scenario}/sample - реальный JSON примера для сверки со схемой.

импорт AlexKey::OpenAPI::Основное

метод ОглавлениеGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    // Ссылки относительные: оглавление открывается по адресу /api/docs без завершающей косой черты
    знч Пункты = Строки.Соединить(Сценарии.Имена().Преобразовать(Сценарий -> ПунктОглавления(Сценарий)))
    знч Страница =
        "<!DOCTYPE html>
         <html>
            <head><meta charset=\"UTF-8\"><title>AlexKey::OpenAPI - тестовое приложение</title></head>
            <body>
                <h1>AlexKey::OpenAPI - тестовое приложение</h1>
                <h2>Пример</h2>
                <p><a href=\"shop/docs\">API магазина</a> - полное описание REST API: заказы, каталог, клиенты.
                    Операции можно вызвать из Swagger UI.</p>
                <h2>Сценарии</h2>
                <p>Каждый сценарий проверяет одну возможность генератора: спецификация и реальный JSON примера,
                    который должен соответствовать схеме.</p>
                <ul>%Пункты</ul>
                <h2>Негативные проверки</h2>
                <p><a href=\"checks\">Результаты</a> - ошибочное описание должно останавливать построение
                    спецификации понятным исключением.</p>
            </body>
         </html>"
    ОбработкаЗапросов.Ответ(Запрос, 200, "text/html", Страница)
;

метод СтраницаСценарияGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    ОтветитьДокументом(Запрос, ЭтоСтраница = Истина)
;

метод СпецификацияСценарияGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    ОтветитьДокументом(Запрос, ЭтоСтраница = Ложь)
;

метод ПримерСценарияGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    знч Сценарий = СценарийЗапроса(Запрос)
    знч Пример = Сценарии.ПримерСценария(Сценарий)
    если Пример == Неопределено
        ОбработкаЗапросов.ОтветОшибка(Запрос, 404, "Сценарий '%Сценарий' не найден")
        возврат
    ;
    ОбработкаЗапросов.ОтветJson(Запрос, Пример)
;

// Ошибка описания возвращается текстом в ответе 500: ее и проверяют сценарии
@Локально
метод ОтветитьДокументом(Запрос: HttpСервисЗапрос, ЭтоСтраница: Булево)
    знч Сценарий = СценарийЗапроса(Запрос)
    знч Спецификация = Сценарии.СпецификацияСценария(Сценарий)
    если Спецификация == Неопределено
        ОбработкаЗапросов.ОтветОшибка(Запрос, 404, "Сценарий '%Сценарий' не найден")
        возврат
    ;
    попытка
        если ЭтоСтраница
            ОбработкаЗапросов.Ответ(Запрос, 200, "text/html", OpenApi.СтраницаSwaggerUi(Спецификация))
        иначе
            ОбработкаЗапросов.Ответ(Запрос, 200, "application/json", OpenApi.ВJson(Спецификация))
        ;
    поймать Ошибка: ИсключениеНедопустимоеСостояние
        ОбработкаЗапросов.ОтветОшибка(Запрос, 500, Ошибка.Описание)
    ;
;

@Локально
метод СценарийЗапроса(Запрос: HttpСервисЗапрос): Строка
    возврат Запрос.Параметры.ПолучитьПервый("scenario") ?? ""
;

@Локально
метод ПунктОглавления(Сценарий: Строка): Строка
    знч Заголовок = Сценарии.СпецификацияСценария(Сценарий)?.Заголовок ?? ""
    возврат "<li><a href=\"docs/%Сценарий\">%Сценарий</a> - %Заголовок"
        + " · <a href=\"docs/%Сценарий/openapi.json\">openapi.json</a>"
        + " · <a href=\"docs/%Сценарий/sample\">sample</a></li>"
;
