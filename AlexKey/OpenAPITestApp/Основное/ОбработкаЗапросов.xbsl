// Общие методы ответов HTTP-сервисов тестового приложения.
// Ошибки возвращаются в формате Problem Details (RFC 9457) — так их описывает генератор.

@ВПодсистеме
метод Ответ(Запрос: HttpСервисЗапрос, КодСтатуса: Число, ТипСодержимого: Строка, Тело: Строка)
    Запрос.Ответ.УстановитьКодСтатуса(КодСтатуса)
    Запрос.Ответ.Заголовки.Установить("Content-Type", ТипСодержимого + "; charset=utf-8")
    Запрос.Ответ.УстановитьТело(Тело, "UTF-8")
;

// Сериализация с настройками по умолчанию: именно такой JSON описывает спецификация
@ВПодсистеме
метод ОтветJson(Запрос: HttpСервисЗапрос, Тело: Объект, КодСтатуса: Число = 200)
    Ответ(Запрос, КодСтатуса, "application/json", СериализацияJson.ЗаписатьОбъект(Тело))
;

@ВПодсистеме
метод ОтветБезСодержимого(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.УстановитьКодСтатуса(204)
;

@ВПодсистеме
метод ОтветОшибка(Запрос: HttpСервисЗапрос, КодСтатуса: Число, Описание: Строка)
    знч Тело = СериализацияJson.ЗаписатьОбъект({"status": КодСтатуса, "detail": Описание})
    Ответ(Запрос, КодСтатуса, "application/problem+json", Тело)
;
