// Сценарии проверки генератора OpenAPI.
// Пример - реальный JSON, записанный СериализацияJson с настройками по умолчанию. Спецификация сценария
// описывает адрес примера операцией, поэтому пример можно вызвать из Swagger UI и сверить со схемой.

импорт AlexKey::OpenAPI::Основное

// Имена сценариев - сегменты адреса /api/docs/{сценарий}

// Строка, Число, Булево, Ууид, Дата, ДатаВремя, Время, перечисление элемента проекта
конст ПРОСТЫЕ = "simple"
// Момент, Длительность, Байты
конст ОСОБЫЕ = "special"
// Те же типы с Неопределено: null в type/enum, поле не входит в required
конст НЕОБЯЗАТЕЛЬНЫЕ = "nullable"
// Массив, Множество, Соответствие, вложенные массивы, рекурсивные и взаимные ссылки структур
конст КОЛЛЕКЦИИ = "collections"
// JsonСвойство, поле без аннотации, JsonИгнорироватьСвойство
конст ИМЕНА_JSON = "json-names"
// Перечисление модуля с JsonЭлементПеречисления
конст ПЕРЕЧИСЛЕНИЯ_JSON = "json-enum"
// Параметры пути и запроса, тело, ответы со схемой и без, Уточнить, устаревшая операция
конст ОПЕРАЦИИ = "operations"

// Страница и спецификация сценария лежат в /api/docs/{сценарий}/, корень API - на два уровня выше
конст СЕРВЕР = "../../"
конст ТЕГ_ТОВАРЫ = "Items"

перечисление СпособОплаты
    @JsonЭлементПеречисления("card")
    Карта умолчание,
    @JsonЭлементПеречисления("cash")
    Наличные,
    Перевод
;

структура Оплата
    @JsonСвойство("method")
    пер Способ: СпособОплаты = СпособОплаты.Карта
    @JsonСвойство("fallbackMethod")
    пер ЗапаснойСпособ: СпособОплаты? = Неопределено
    @JsonСвойство("amount")
    пер Сумма: Число = 0
;

@ВПодсистеме
метод Имена(): ЧитаемыйМассив<Строка>
    возврат [ПРОСТЫЕ, ОСОБЫЕ, НЕОБЯЗАТЕЛЬНЫЕ, КОЛЛЕКЦИИ, ИМЕНА_JSON, ПЕРЕЧИСЛЕНИЯ_JSON, ОПЕРАЦИИ]
;

@ВПодсистеме
метод СпецификацияСценария(Сценарий: Строка): СпецификацияOpenApi?
    выбор Сценарий
    когда ПРОСТЫЕ
        возврат СпецификацияПримера(Сценарий, "Простые типы", OpenApi.Схема(Тип<ПростыеТипы>), [
            OpenApi.Модель(Тип<ПростыеТипы>, "SimpleTypes", "Простые типы без Неопределено",
                {"text": "Строка", "uuid": "Ууид", "status": "Перечисление из элемента проекта"})
        ])
    когда ОСОБЫЕ
        возврат СпецификацияПримера(Сценарий, "Момент, Длительность, Байты", OpenApi.Схема(Тип<ОсобыеТипы>), [
            OpenApi.Модель(Тип<ОсобыеТипы>, "SpecialTypes", "Типы, у которых значение по умолчанию не описано")
        ])
    когда НЕОБЯЗАТЕЛЬНЫЕ
        возврат СпецификацияПримера(Сценарий, "Необязательные поля", OpenApi.Схема(Тип<НеобязательныеТипы>), [
            OpenApi.Модель(Тип<НеобязательныеТипы>, "NullableTypes", "Все простые типы с Неопределено")
        ])
    когда КОЛЛЕКЦИИ
        возврат СпецификацияПримера(Сценарий, "Коллекции и ссылки", OpenApi.Схема(Тип<Коллекции>), [
            OpenApi.Модель(Тип<Коллекции>, "Collections"),
            OpenApi.Модель(Тип<Узел>, "Node", "Ссылается сам на себя"),
            OpenApi.Модель(Тип<Автор>, "Author", "Ссылается на Book, а Book - на Author"),
            OpenApi.Модель(Тип<Книга>, "Book")
        ])
    когда ИМЕНА_JSON
        возврат СпецификацияПримера(Сценарий, "Имена полей в JSON", OpenApi.Схема(Тип<ИменаJson>), [
            OpenApi.Модель(Тип<ИменаJson>, "JsonNames", "JsonСвойство, поле без аннотации, JsonИгнорироватьСвойство")
        ])
    когда ПЕРЕЧИСЛЕНИЯ_JSON
        возврат СпецификацияПримера(Сценарий, "Перечисление с JsonЭлементПеречисления",
            OpenApi.МассивИз(Тип<Оплата>), [
                OpenApi.Модель(Тип<Оплата>, "Payment", "Структура и перечисление, объявленные в модуле")
            ])
    когда ОПЕРАЦИИ
        возврат СпецификацияОпераций()
    иначе
        возврат Неопределено
    ;
;

@ВПодсистеме
метод ПримерСценария(Сценарий: Строка): Объект?
    выбор Сценарий
    когда ПРОСТЫЕ
        возврат новый ПростыеТипы(
            Текст = "строка",
            Количество = 12.5,
            Флаг = Истина,
            Идентификатор = Ууид{0b8f6e0c-5f7e-4c1a-9d3e-2f1a7c4b9e10},
            ДатаСобытия = Дата{2024-01-10},
            ДатаВремяСобытия = ДатаВремя{2024-01-10T19:27:03.837},
            ВремяСобытия = Время{19:27:03},
            Статус = ВидСтатуса.Активен)
    когда ОСОБЫЕ
        возврат новый ОсобыеТипы(
            МоментСобытия = Момент.Сейчас(),
            Продолжительность = 1д30м,
            Содержимое = Байты{48656C6C6F})
    когда НЕОБЯЗАТЕЛЬНЫЕ
        возврат новый НеобязательныеТипы(Текст = "строка", Статус = ВидСтатуса.Архив)
    когда КОЛЛЕКЦИИ
        возврат ПримерКоллекций()
    когда ИМЕНА_JSON
        возврат новый ИменаJson(
            Идентификатор = "42",
            ПолеБезАннотации = "имя поля из кода",
            Служебное = "не попадает в JSON")
    когда ПЕРЕЧИСЛЕНИЯ_JSON
        возврат [
            новый Оплата(Способ = СпособОплаты.Карта, Сумма = 10),
            новый Оплата(Способ = СпособОплаты.Наличные, ЗапаснойСпособ = СпособОплаты.Перевод, Сумма = 100)
        ]
    когда ОПЕРАЦИИ
        знч Позиции = ТоварыПримера()
        возврат {"items": Позиции, "total": Позиции.Размер()}
    иначе
        возврат Неопределено
    ;
;

@ВПодсистеме
метод ТоварыПримера(): Массив<Товар>
    возврат [
        новый Товар(
            Ид = Ууид{6f1c2d3e-4b5a-4c7d-8e9f-0a1b2c3d4e5f},
            Наименование = "Чайник",
            Цена = 2490.5,
            Статус = ВидСтатуса.Активен,
            Метки = ["кухня", "электрика"],
            Создан = ДатаВремя{2024-01-10T19:27:03.857},
            Описание = "Объем 1,7 л"),
        новый Товар(
            Ид = Ууид{0d9e8f7a-6b5c-4d3e-9f1a-2b3c4d5e6f70},
            Наименование = "Кружка",
            Цена = 350,
            Статус = ВидСтатуса.Архив,
            Метки = <Строка>[],
            Создан = ДатаВремя{2023-12-01T09:00:00})
    ]
;

@Локально
метод СпецификацияПримера(
        Сценарий: Строка,
        Заголовок: Строка,
        СхемаПримера: СхемаOpenApi,
        Модели: Массив<МодельOpenApi>
    ): СпецификацияOpenApi

    возврат OpenApi.Спецификация(
        Заголовок,
        Проект.Версия.ВСтроку(),
        Сервер = СЕРВЕР,
        АвторизацияBearer = Ложь,
        Модели = Модели,
        Операции = [
            OpenApi.Операция("GET", "/docs/%Сценарий/sample", "Пример данных сценария",
                Ид = "getSample",
                Описание = "Реальный JSON, записанный СериализацияJson с настройками по умолчанию.",
                Ответы = [OpenApi.Ответ(200, СхемаПримера)])
        ])
;

@Локально
метод СпецификацияОпераций(): СпецификацияOpenApi
    возврат OpenApi.Спецификация(
        "Операции",
        Проект.Версия.ВСтроку(),
        Описание = "Параметры пути и запроса, тело запроса, ответы со схемой и без, устаревшая операция. "
            + "Операции реализованы HTTP-сервисом Товары, их можно вызвать из Swagger UI.",
        Сервер = СЕРВЕР,
        АвторизацияBearer = Ложь,
        Теги = [OpenApi.Тег(ТЕГ_ТОВАРЫ, "Тестовый ресурс")],
        Модели = [
            OpenApi.Модель(Тип<Товар>, "Item", "Товар",
                {"id": "Идентификатор", "name": "Наименование", "price": "Цена"})
        ],
        Параметры = [OpenApi.ПараметрПути("itemId", "Идентификатор товара", OpenApi.Схема(Тип<Ууид>))],
        Операции = [
            OpenApi.Операция("GET", "/items", "Список товаров",
                Тег = ТЕГ_ТОВАРЫ,
                Ид = "listItems",
                Параметры = [
                    OpenApi.ПараметрЗапроса("status", "Отбор по статусу", OpenApi.Схема(Тип<ВидСтатуса>)),
                    OpenApi.ПараметрЗапроса("q", "Подстрока наименования без учета регистра", ПоисковаяСтрока())
                ],
                Ответы = [
                    OpenApi.Ответ(200, OpenApi.ОбъектИз({
                        "items": OpenApi.МассивИз(Тип<Товар>),
                        "total": OpenApi.Схема(Тип<Число>)
                    }, ["items", "total"]))
                ]),

            OpenApi.Операция("POST", "/items", "Создать товар",
                Тег = ТЕГ_ТОВАРЫ,
                Ид = "createItem",
                Описание = "Возвращает прочитанный товар: тело по схеме должно читаться платформой.",
                Тело = OpenApi.Схема(Тип<Товар>),
                Ответы = [OpenApi.Ответ(201, Тип<Товар>), OpenApi.Ответ(400)]),

            OpenApi.Операция("GET", "/items/{itemId}", "Получить товар",
                Тег = ТЕГ_ТОВАРЫ,
                Ид = "getItem",
                Ответы = [OpenApi.Ответ(200, Тип<Товар>), OpenApi.Ответ(404)]),

            OpenApi.Операция("DELETE", "/items/{itemId}", "Удалить товар",
                Тег = ТЕГ_ТОВАРЫ,
                Ид = "deleteItem",
                Описание = "Ничего не удаляет: пример устаревшей операции без тела ответа.",
                Устарело = Истина,
                Ответы = [OpenApi.Ответ(204), OpenApi.Ответ(404)])
        ])
;

@Локально
метод ПоисковаяСтрока(): СхемаOpenApi
    знч Непустая = OpenApi.Уточнить(OpenApi.Схема(Тип<Строка>), <Строка, Объект?>{"minLength": 1})
    возврат OpenApi.Уточнить(Непустая, <Строка, Объект?>{"maxLength": 100})
;

@Локально
метод ПримерКоллекций(): Коллекции
    знч Лист = новый Узел(Имя = "лист")
    знч КорневойУзел = новый Узел(Имя = "корень", Дети = [Лист])
    знч АвторКниги = новый Автор(Имя = "Автор")
    возврат новый Коллекции(
        Строки = ["а", "б"],
        НеобязательныеСтроки = <Строка?>["а", Неопределено],
        Числа = <Число>{1, 2},
        Матрица = [[1, 2], [3]],
        Словарь = {"один": 1},
        Узлы = [КорневойУзел],
        УзлыПоИмени = {"лист": Лист},
        Корень = КорневойУзел,
        Книги = [новый Книга(Название = "Книга", Автор = АвторКниги)])
;
