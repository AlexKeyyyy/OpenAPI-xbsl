// /api/items - реализация операций сценария operations, чтобы вызывать их из Swagger UI.

метод СписокТоваровGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    знч Статус = Запрос.Параметры.ПолучитьПервый("status")
    знч Поиск = Запрос.Параметры.ПолучитьПервый("q") ?? ""
    // Элемент перечисления без JsonЭлементПеречисления записывается в JSON своим именем
    знч Найденные = Сценарии.ТоварыПримера()
        .Фильтровать(Позиция -> Статус == Неопределено или Позиция.Статус.ВСтроку() == Статус)
        .Фильтровать(Позиция -> Позиция.Наименование.Содержит(Поиск, ИгнорироватьРегистр = Истина))
    ОбработкаЗапросов.ОтветJson(Запрос, {"items": Найденные, "total": Найденные.Размер()})
;

метод СписокТоваровPOSTОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    попытка
        знч Прочитанный = СериализацияJson.ПрочитатьОбъект(Запрос.Тело.ПрочитатьКакСтроку(), Тип<Товар>)
        ОбработкаЗапросов.ОтветJson(Запрос, Прочитанный, 201)
    поймать Ошибка: ИсключениеЧтенияJson
        ОбработкаЗапросов.ОтветОшибка(Запрос, 400, Ошибка.Описание)
    ;
;

метод ТоварПоИдGETОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    знч Найденный = ТоварЗапроса(Запрос)
    если Найденный == Неопределено
        возврат
    ;
    ОбработкаЗапросов.ОтветJson(Запрос, Найденный)
;

метод ТоварПоИдDELETEОбработкаЗапроса(Запрос: HttpСервисЗапрос)
    если ТоварЗапроса(Запрос) != Неопределено
        ОбработкаЗапросов.ОтветБезСодержимого(Запрос)
    ;
;

// Товар из параметра пути itemId. Если он не найден, отвечает 404.
@Локально
метод ТоварЗапроса(Запрос: HttpСервисЗапрос): Товар?
    знч Ид = Запрос.Параметры.ПолучитьПервый("itemId") ?? ""
    знч Найденный = Сценарии.ТоварыПримера()
        .Фильтровать(Позиция -> Позиция.Ид.ВСтроку() == Ид)
        .ПервыйИлиНеопределено()
    если Найденный == Неопределено
        ОбработкаЗапросов.ОтветОшибка(Запрос, 404, "Товар '%Ид' не найден")
    ;
    возврат Найденный
;
