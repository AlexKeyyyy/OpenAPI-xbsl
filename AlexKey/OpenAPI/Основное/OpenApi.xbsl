/*
Построение спецификации OpenAPI 3.1 для HTTP-сервисов.

Операции описываются вызовами функций модуля, схемы данных строятся по типам автоматически:
 * Строка, Число, Булево, Ууид, Дата, ДатаВремя, Момент, Время, Длительность, Байты, перечисления
   (значения - с учетом JsonЭлементПеречисления);
 * структуры: поля через отражение, имена полей из JsonСвойство, поля с JsonИгнорироватьСвойство пропускаются,
   вложенные структуры выносятся в components/schemas и подключаются через $ref;
 * T? - допускает null и не входит в required; Массив<T>, Множество<T> - array; Соответствие<Строка, T> - object.
Каждая структура, попавшая в схему, должна быть объявлена через Модель(): там задаются имя схемы и описания.

Пример:

 * знч Спецификация = OpenApi.Спецификация("API товаров", "1.0",
 *     Операции = [
 *         OpenApi.Операция("GET", "/items", "Получить товары",
 *             Ответы = [OpenApi.Ответ(200, OpenApi.ОбъектИз({"items": OpenApi.МассивИз(Тип<ДанныеТовара>)}))]),
 *         OpenApi.Операция("GET", "/items/{id}", "Получить товар",
 *             Ответы = [OpenApi.Ответ(200, Тип<ДанныеТовара>), OpenApi.Ответ(404)]),
 *         OpenApi.Операция("POST", "/items", "Создать товар",
 *             Тело = OpenApi.Схема(Тип<ДанныеТовара>),
 *             Ответы = [OpenApi.Ответ(201, Тип<ДанныеТовара>), OpenApi.Ответ(400)])
 *     ],
 *     Модели = [
 *         OpenApi.Модель(Тип<ДанныеТовара>, "Item", "Товар", {"id": "Идентификатор", "name": "Наименование"})
 *     ],
 *     Параметры = [OpenApi.ПараметрПути("id", "Идентификатор товара")])
 * 
 * Запрос.Ответ.УстановитьТело(OpenApi.ВJson(Спецификация))

Соглашения:
 * схема данных всегда имеет тип СхемаOpenApi; тип данных превращается в схему через Схема(Тип<...>),
   а для Ответ и МассивИз есть перегрузки, принимающие тип напрямую;
 * параметры пути из шаблона {имя} добавляются автоматически, описание берется из Параметры спецификации;
 * ответ 4xx/5xx без схемы описывается как Problem (RFC 9457) с типом application/problem+json;
 * описание ответа по умолчанию подставляется по коду;
 * ошибки описания (повтор операции, модели, operationId, недопустимый метод, лишний параметр пути)
   выбрасываются при построении спецификации исключением ИсключениеОписания.

Ограничения: схема соответствует JSON, записанному СериализацияJson с настройками по умолчанию.
Не описываются: пропуск пустых значений (@JsonОбъект), сведения о типе у полей составного типа,
кроме T? (РежимЗаписиТипаJson.ЗаписыватьПриНеоднозначности), формат Момент, отличный от Iso.
Структура-модель должна создаваться без аргументов: у каждого поля нужно значение по умолчанию.
 */

конст ИМЯ_СХЕМЫ_ОШИБКИ = "Problem"
конст ТИП_СОДЕРЖИМОГО_JSON = "application/json"
конст ТИП_СОДЕРЖИМОГО_PROBLEM = "application/problem+json"
конст РАСПОЛОЖЕНИЕ_В_ПУТИ = "path"
конст РАСПОЛОЖЕНИЕ_В_ЗАПРОСЕ = "query"
конст АДРЕС_SWAGGER_UI = "https://cdnjs.cloudflare.com/ajax/libs/swagger-ui/5.18.2"
// ДатаВремя и Время записываются без смещения ("2024-01-10T19:27:03.857"), а format date-time и time
// по RFC 3339 требуют его, поэтому формат задается шаблоном
конст ШАБЛОН_ДАТЫ_ВРЕМЕНИ = "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?\$"
конст ШАБЛОН_ВРЕМЕНИ = "^[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?\$"

// Ошибка в описании API: повтор операции или модели, структура без модели и т. п.
@Глобально
исключение ИсключениеОписания
;

// Описание API

// Параметры - описания параметров пути, общих для операций; параметры запроса объявляются в операции
@Глобально
метод Спецификация(
        Заголовок: Строка,
        Версия: Строка,
        Операции: Массив<ОперацияOpenApi>,
        Описание: Строка = "",
        Теги: Массив<ТегOpenApi>? = Неопределено,
        Модели: Массив<МодельOpenApi>? = Неопределено,
        Параметры: Массив<ПараметрOpenApi>? = Неопределено,
        Сервер: Строка = "../",
        АвторизацияBearer: Булево = Истина
    ): СпецификацияOpenApi

    возврат новый СпецификацияOpenApi(
        Заголовок = Заголовок,
        Версия = Версия,
        Описание = Описание,
        Сервер = Сервер,
        АвторизацияBearer = АвторизацияBearer,
        Теги = Теги ?? <ТегOpenApi>[],
        Операции = Операции,
        Модели = Модели ?? <МодельOpenApi>[],
        Параметры = Параметры ?? <ПараметрOpenApi>[])
;

@Глобально
метод Тег(Имя: Строка, Описание: Строка = ""): ТегOpenApi
    возврат новый ТегOpenApi(Имя = Имя, Описание = Описание)
;

// Объявляет структуру моделью components/schemas. ОписанияПолей - по именам полей в JSON.
@Глобально
метод Модель(
        ТипДанных: Тип<Объект?>,
        Имя: Строка,
        Описание: Строка = "",
        ОписанияПолей: Соответствие<Строка, Строка>? = Неопределено
    ): МодельOpenApi

    возврат новый МодельOpenApi(
        ТипДанных = ТипДанных,
        Имя = Имя,
        Описание = Описание,
        ОписанияПолей = ОписанияПолей ?? <Строка, Строка>{:})
;

// Метод - GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS или TRACE
@Глобально
метод Операция(
        Метод: Строка,
        Путь: Строка,
        Кратко: Строка,
        Ответы: Массив<ОтветOpenApi>,
        Тег: Строка = "",
        Описание: Строка = "",
        Параметры: Массив<ПараметрOpenApi>? = Неопределено,
        Тело: СхемаOpenApi? = Неопределено,
        Ид: Строка = "",
        Устарело: Булево = Ложь
    ): ОперацияOpenApi

    возврат новый ОперацияOpenApi(
        Метод = Метод.ВНижнийРегистр(),
        Путь = Путь,
        Кратко = Кратко,
        Описание = Описание,
        Тег = Тег,
        Ид = Ид,
        Параметры = Параметры ?? <ПараметрOpenApi>[],
        Тело = Тело,
        Ответы = Ответы,
        Устарело = Устарело)
;

// Ответ без тела. Для 4xx/5xx тело описывается как Problem (RFC 9457).
@Глобально
метод Ответ(Код: Число, Описание: Строка = ""): ОтветOpenApi
    возврат новый ОтветOpenApi(Код = Код, Описание = ОписаниеОтвета(Код, Описание),
        ТипСодержимого = ТИП_СОДЕРЖИМОГО_JSON)
;

@Глобально
метод Ответ(
        Код: Число,
        Схема: СхемаOpenApi,
        Описание: Строка = "",
        ТипСодержимого: Строка = ТИП_СОДЕРЖИМОГО_JSON
    ): ОтветOpenApi

    возврат новый ОтветOpenApi(Код = Код, Описание = ОписаниеОтвета(Код, Описание), Схема = Схема,
        ТипСодержимого = ТипСодержимого)
;

@Глобально
метод Ответ(
        Код: Число,
        ТипДанных: Тип<Объект?>,
        Описание: Строка = "",
        ТипСодержимого: Строка = ТИП_СОДЕРЖИМОГО_JSON
    ): ОтветOpenApi

    возврат Ответ(Код, Схема(ТипДанных), Описание, ТипСодержимого)
;

@Глобально
метод ПараметрПути(Имя: Строка, Описание: Строка = "", Схема: СхемаOpenApi? = Неопределено): ПараметрOpenApi
    возврат Параметр(Имя, РАСПОЛОЖЕНИЕ_В_ПУТИ, Описание, Схема, Обязательный = Истина)
;

@Глобально
метод ПараметрЗапроса(
        Имя: Строка,
        Описание: Строка = "",
        Схема: СхемаOpenApi? = Неопределено,
        Обязательный: Булево = Ложь
    ): ПараметрOpenApi

    возврат Параметр(Имя, РАСПОЛОЖЕНИЕ_В_ЗАПРОСЕ, Описание, Схема, Обязательный)
;

// Схемы

// Схема по типу данных: простого типа, структуры или коллекции.
@Глобально
метод Схема(ТипДанных: Тип<Объект?>, Описание: Строка = ""): СхемаOpenApi
    возврат новый СхемаOpenApi(ТипДанных = ТипДанных, Описание = Описание)
;

@Глобально
метод МассивИз(Элементы: СхемаOpenApi, Описание: Строка = ""): СхемаOpenApi
    возврат новый СхемаOpenApi(Элементы = Элементы, Описание = Описание)
;

@Глобально
метод МассивИз(ТипЭлементов: Тип<Объект?>, Описание: Строка = ""): СхемаOpenApi
    возврат МассивИз(Схема(ТипЭлементов), Описание)
;

// Объект с указанными свойствами. Если Обязательные не заданы, обязательны все свойства.
@Глобально
метод ОбъектИз(
        Свойства: Соответствие<Строка, СхемаOpenApi>,
        Обязательные: Массив<Строка>? = Неопределено,
        Описание: Строка = ""
    ): СхемаOpenApi

    возврат новый СхемаOpenApi(
        Свойства = Свойства,
        Обязательные = Обязательные ?? Свойства.Ключи().ВМассив(),
        Описание = Описание)
;

// Схема с дополнительными ключевыми словами JSON Schema, например Уточнить(Схема(Тип<Строка>), {"format": "email"}).
// Ключевые слова основы сохраняются, совпадающие - заменяются.
@Глобально
метод Уточнить(
        Основа: СхемаOpenApi,
        КлючевыеСлова: Соответствие<Строка, Объект?>,
        Описание: Строка = ""
    ): СхемаOpenApi

    знч ВсеКлючевыеСлова = <Строка, Объект?>{:}
    ВсеКлючевыеСлова.ВставитьВсе(Основа.КлючевыеСлова ?? <Строка, Объект?>{:})
    ВсеКлючевыеСлова.ВставитьВсе(КлючевыеСлова)
    возврат новый СхемаOpenApi(
        ТипДанных = Основа.ТипДанных,
        Элементы = Основа.Элементы,
        Свойства = Основа.Свойства,
        Обязательные = Основа.Обязательные,
        КлючевыеСлова = ВсеКлючевыеСлова,
        Описание = Описание.Пусто() ? Основа.Описание : Описание)
;

// Формирование

@Глобально
метод ВJson(Спецификация: СпецификацияOpenApi): Строка
    возврат СериализацияJson.ЗаписатьОбъект(Документ(Спецификация))
;

// Страница Swagger UI со встроенной спецификацией. АдресРесурсов - каталог swagger-ui.css и скриптов,
// например внутреннее зеркало для контура без доступа к CDN.
// Относительный адрес сервера разрешается от каталога страницы, поэтому /docs и /docs/ дают один результат.
@Глобально
метод СтраницаSwaggerUi(Спецификация: СпецификацияOpenApi, АдресРесурсов: Строка = АДРЕС_SWAGGER_UI): Строка
    знч Настройки = новый НастройкиЗаписиОбъектовJson()
    Настройки.ЭкранироватьУгловыеСкобки = Истина
    знч Json = СериализацияJson.ЗаписатьОбъект(Документ(Спецификация), Настройки)
    знч Заголовок = УтилитыHtml.Экранировать(Спецификация.Заголовок, РежимЭкранированияHtml.Xhtml)
    возврат
        "<!DOCTYPE html>
         <html>
             <head>
                 <meta charset=\"UTF-8\">
                 <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
                 <title>%Заголовок</title>
                 <link rel=\"stylesheet\" href=\"%{АдресРесурсов}/swagger-ui.css\">
                 <style>.topbar {display: none;}</style>
             </head>
             <body>
                 <div id=\"swagger-ui\"></div>
                 <script src=\"%{АдресРесурсов}/swagger-ui-bundle.js\"></script>
                 <script src=\"%{АдресРесурсов}/swagger-ui-standalone-preset.js\"></script>
                 <script>
                     var spec = %Json;
                     var base = location.origin + location.pathname;
                     if (base.charAt(base.length - 1) !== '/') {
                         base += '/';
                     }
                     spec.servers = (spec.servers || []).map(function (server) {
                         return Object.assign({}, server, {url: new URL(server.url, base).href});
                     });
                     window.onload = function () {
                         window.ui = SwaggerUIBundle({
                             spec: spec,
                             dom_id: '#swagger-ui',
                             deepLinking: true,
                             presets: [SwaggerUIBundle.presets.apis, SwaggerUIStandalonePreset],
                             plugins: [SwaggerUIBundle.plugins.DownloadUrl],
                             layout: 'StandaloneLayout',
                             tagsSorter: 'alpha',
                             operationsSorter: 'alpha'
                         });
                     };
                 </script>
             </body>
         </html>"
;

// Документ

структура КонтекстПостроения
    обз знч Спецификация: СпецификацияOpenApi
    // Модели по полному имени типа
    обз знч Модели: Соответствие<Строка, МодельOpenApi>
    // Накапливаемые components/schemas
    обз знч Схемы: Соответствие<Строка, Объект?>
;

@Локально
метод Документ(Спецификация: СпецификацияOpenApi): Соответствие<Строка, Объект?>
    ПроверитьСпецификацию(Спецификация)
    знч Контекст = новый КонтекстПостроения(
        Спецификация = Спецификация,
        Модели = <Строка, МодельOpenApi>{:},
        Схемы = <Строка, Объект?>{:})
    для Модель из Спецификация.Модели
        Контекст.Модели.Вставить(Модель.ТипДанных.ВСтроку(), Модель)
    ;

    знч Пути = <Строка, Соответствие<Строка, Объект?>>{:}
    для Операция из Спецификация.Операции
        Пути.ВставитьЕслиОтсутствует(Операция.Путь, <Строка, Объект?>{:})
            .Вставить(Операция.Метод, ОперацияJson(Операция, Контекст))
    ;

    знч Информация =
        <Строка, Объект?>{
            "title": Спецификация.Заголовок,
            "version": Спецификация.Версия
        }
    ВставитьНеПустое(Информация, "description", Спецификация.Описание)
    знч Компоненты =
        <Строка, Объект?>{
            "schemas": Контекст.Схемы
        }
    знч Документ =
        <Строка, Объект?>{
            "openapi": "3.1.0",
            "info": Информация,
            "servers": [{
                "url": Спецификация.Сервер
            }],
            "tags": Спецификация.Теги.Преобразовать(Тег -> ТегJson(Тег)),
            "paths": Пути,
            "components": Компоненты
        }
    если Спецификация.АвторизацияBearer
        Документ.Вставить("security", [{
                "Bearer": <Строка>[]
            }])
        Компоненты.Вставить("securitySchemes", {
                "Bearer": {
                    "type": "http",
                    "scheme": "bearer"
                }
            })
    ;
    возврат Документ
;

@Локально
метод ТегJson(Тег: ТегOpenApi): Соответствие<Строка, Объект?>
    знч Json =
        <Строка, Объект?>{
            "name": Тег.Имя
        }
    ВставитьНеПустое(Json, "description", Тег.Описание)
    возврат Json
;

@Локально
метод ОперацияJson(Операция: ОперацияOpenApi, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч Json =
        <Строка, Объект?>{
            "summary": Операция.Кратко
        }
    ВставитьНеПустое(Json, "description", Операция.Описание)
    ВставитьНеПустое(Json, "operationId", Операция.Ид)
    если не Операция.Тег.Пусто()
        Json.Вставить("tags", [Операция.Тег])
    ;
    если Операция.Устарело
        Json.Вставить("deprecated", Истина)
    ;

    знч Параметры = ПараметрыОперации(Операция, Контекст.Спецификация)
    если не Параметры.Пусто()
        Json.Вставить("parameters", Параметры.Преобразовать(Параметр -> ПараметрJson(Параметр, Контекст)))
    ;

    знч Тело = Операция.Тело
    если Тело != Неопределено
        Json.Вставить("requestBody", {
                "required": Истина,
                "content": Содержимое(ТИП_СОДЕРЖИМОГО_JSON, СхемаJson(Тело, Контекст))
            })
    ;

    знч Ответы = <Строка, Объект?>{:}
    для Ответ из Операция.Ответы
        Ответы.Вставить(Ответ.Код.ВСтроку(), ОтветJson(Ответ, Контекст))
    ;
    Json.Вставить("responses", Ответы)
    возврат Json
;

// Явно объявленные параметры и параметры шаблона пути {имя}; описания параметров пути - из спецификации
@Локально
метод ПараметрыОперации(Операция: ОперацияOpenApi, Спецификация: СпецификацияOpenApi): Массив<ПараметрOpenApi>
    знч Параметры = <ПараметрOpenApi>[]
    Параметры.ДобавитьВсе(Операция.Параметры)
    для Имя из ПараметрыШаблона(Операция.Путь)
        если не Параметры.ЕстьСоответствия(Параметр -> ЭтоПараметрПути(Параметр, Имя))
            Параметры.Добавить(
                Спецификация.Параметры.Фильтровать(Параметр -> ЭтоПараметрПути(Параметр, Имя)).ПервыйИлиНеопределено()
                    ?? ПараметрПути(Имя))
        ;
    ;
    возврат Параметры
;

// Имена параметров из шаблона пути: "/items/{id}" -> ["id"]
@Локально
метод ПараметрыШаблона(Путь: Строка): ЧитаемыйМассив<Строка>
    возврат Путь.Разделить("/")
        .Фильтровать(Сегмент -> Сегмент.НачинаетсяС("{") и Сегмент.ЗаканчиваетсяНа("}"))
        .Преобразовать(Сегмент -> Сегмент.Удалить("{").Удалить("}"))
;

@Локально
метод ЭтоПараметрПути(Параметр: ПараметрOpenApi, Имя: Строка): Булево
    возврат Параметр.Имя == Имя и Параметр.Расположение == РАСПОЛОЖЕНИЕ_В_ПУТИ
;

@Локально
метод ПараметрJson(Параметр: ПараметрOpenApi, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч Json =
        <Строка, Объект?>{
            "name": Параметр.Имя,
            "in": Параметр.Расположение,
            "required": Параметр.Обязательный,
            "schema": СхемаJson(Параметр.Схема, Контекст)
        }
    ВставитьНеПустое(Json, "description", Параметр.Описание)
    возврат Json
;

@Локально
метод ОтветJson(Ответ: ОтветOpenApi, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч Json =
        <Строка, Объект?>{
            "description": Ответ.Описание
        }
    знч Схема = Ответ.Схема
    если Схема != Неопределено
        Json.Вставить("content", Содержимое(Ответ.ТипСодержимого, СхемаJson(Схема, Контекст)))
    иначе если Ответ.Код >= 400
        Контекст.Схемы.ВставитьЕслиОтсутствует(ИМЯ_СХЕМЫ_ОШИБКИ, СхемаProblem())
        Json.Вставить("content", Содержимое(ТИП_СОДЕРЖИМОГО_PROBLEM, Ссылка(ИМЯ_СХЕМЫ_ОШИБКИ)))
    ;
    возврат Json
;

@Локально
метод Содержимое(ТипСодержимого: Строка, Схема: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    знч Json = <Строка, Объект?>{:}
    Json.Вставить(ТипСодержимого, {
            "schema": Схема
        })
    возврат Json
;

// Проверка описания

// Ошибки описания обнаруживаются при построении, а не в клиентах, получивших некорректную спецификацию
@Локально
метод ПроверитьСпецификацию(Спецификация: СпецификацияOpenApi)
    ПроверитьМодели(Спецификация.Модели)
    ПроверитьОперации(Спецификация.Операции)
    для Параметр из Спецификация.Параметры
        если Параметр.Расположение != РАСПОЛОЖЕНИЕ_В_ПУТИ
            выбросить новый ИсключениеОписания(
                "Параметр спецификации '%{Параметр.Имя}' должен быть параметром пути: "
                    + "параметры запроса объявляются в операции")
        ;
    ;
;

@Локально
метод ПроверитьМодели(Модели: Массив<МодельOpenApi>)
    знч Имена = <Строка>{ИМЯ_СХЕМЫ_ОШИБКИ}
    знч Типы = <Строка>{}
    для Модель из Модели
        ДобавитьБезПовтора(Имена, Модель.Имя, "Имя модели OpenAPI '%{Модель.Имя}' уже занято")
        ДобавитьБезПовтора(Типы, Модель.ТипДанных.ВСтроку(),
            "Тип '%{Модель.ТипДанных.Представление()}' объявлен моделью OpenAPI несколько раз")
    ;
;

@Локально
метод ПроверитьОперации(Операции: Массив<ОперацияOpenApi>)
    знч МетодыИПути = <Строка>{}
    знч Ид = <Строка>{}
    для Операция из Операции
        ПроверитьОперацию(Операция)
        ДобавитьБезПовтора(МетодыИПути, "%{Операция.Метод} %{Операция.Путь}",
            "Операция %{Операция.Метод.ВВерхнийРегистр()} %{Операция.Путь} описана несколько раз")
        если не Операция.Ид.Пусто()
            ДобавитьБезПовтора(Ид, Операция.Ид, "Ид операции '%{Операция.Ид}' уже занят")
        ;
    ;
;

@Локально
метод ПроверитьОперацию(Операция: ОперацияOpenApi)
    знч МетодыHttp = {"get", "put", "post", "delete", "options", "head", "patch", "trace"}
    если не МетодыHttp.Содержит(Операция.Метод)
        выбросить новый ИсключениеОписания(
            "Недопустимый HTTP-метод '%{Операция.Метод.ВВерхнийРегистр()}' операции %{Операция.Путь}")
    ;
    знч ПараметрыПути = ПараметрыШаблона(Операция.Путь)
    для Параметр из Операция.Параметры
        если Параметр.Расположение == РАСПОЛОЖЕНИЕ_В_ПУТИ и не ПараметрыПути.Содержит(Параметр.Имя)
            выбросить новый ИсключениеОписания(
                "Параметр пути '%{Параметр.Имя}' отсутствует в шаблоне %{Операция.Путь}")
        ;
    ;
;

@Локально
метод ДобавитьБезПовтора(Значения: Множество<Строка>, Значение: Строка, ТекстОшибки: Строка)
    если не Значения.Добавить(Значение)
        выбросить новый ИсключениеОписания(ТекстОшибки)
    ;
;

// Схемы данных

@Локально
метод СхемаJson(Схема: СхемаOpenApi, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч Json = ОсноваСхемыJson(Схема, Контекст)
    знч КлючевыеСлова = Схема.КлючевыеСлова
    если КлючевыеСлова != Неопределено
        Json.ВставитьВсе(КлючевыеСлова)
    ;
    ВставитьНеПустое(Json, "description", Схема.Описание)
    возврат Json
;

@Локально
метод ОсноваСхемыJson(Схема: СхемаOpenApi, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч ТипДанных = Схема.ТипДанных
    знч Элементы = Схема.Элементы
    знч Свойства = Схема.Свойства

    если ТипДанных != Неопределено
        возврат СхемаТипа(ТипДанных, Контекст)
    иначе если Элементы != Неопределено
        возврат {
            "type": "array",
            "items": СхемаJson(Элементы, Контекст)
        }
    иначе если Свойства != Неопределено
        знч СвойстваJson = <Строка, Объект?>{:}
        для Свойство из Свойства
            СвойстваJson.Вставить(Свойство.Ключ, СхемаJson(Свойство.Значение, Контекст))
        ;
        возврат СхемаОбъекта(СвойстваJson, Схема.Обязательные ?? <Строка>[])
    ;
    возврат <Строка, Объект?>{:}
;

// Простые типы и коллекции описываются на месте, структуры - ссылкой на модель
@Локально
метод СхемаТипа(ТипДанных: Тип<Объект?>, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч ПростаяСхема = СхемаПростогоТипа(ТипДанных)
    знч ПараметрыТипа = ТипДанных.ПараметрыТипа

    если ПростаяСхема != Неопределено
        возврат ПростаяСхема
    иначе если ПараметрыТипа.Размер() == 1
        возврат {
            "type": "array",
            "items": СхемаТипов(ПараметрыТипа[0], Контекст)
        }
    иначе если ПараметрыТипа.Размер() == 2
        возврат {
            "type": "object",
            "additionalProperties": СхемаТипов(ПараметрыТипа[1], Контекст)
        }
    ;
    возврат СсылкаНаМодель(ТипДанных, Контекст)
;

// ТипДанных - всегда один тип: Неопределено и варианты составного типа поля разбирает СхемаТипов.
// Сравнение через МожетБытьПрисвоенВ, а не равенство: так любое перечисление совпадает с Тип<Перечисление>.
// Форматы - как их записывает СериализацияJson с настройками по умолчанию.
@Локально
метод СхемаПростогоТипа(ТипДанных: Тип<Объект?>): Соответствие<Строка, Объект?>?
    если Тип<Объект>.МожетБытьПрисвоенВ(ТипДанных)
        // Объект: любое значение (у поля Объект? сюда приходит Объект, Неопределено учтено в СхемаТипов)
        возврат <Строка, Объект?>{:}
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Строка>)
        возврат {
            "type": "string"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Число>)
        возврат {
            "type": "number"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Булево>)
        возврат {
            "type": "boolean"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Ууид>)
        возврат {
            "type": "string",
            "format": "uuid"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Дата>)
        возврат {
            "type": "string",
            "format": "date"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<ДатаВремя>)
        возврат {
            "type": "string",
            "pattern": ШАБЛОН_ДАТЫ_ВРЕМЕНИ
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Момент>)
        // ФорматМоментаJson.Iso: "2009-02-15T00:00:00Z"
        возврат {
            "type": "string",
            "format": "date-time"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Время>)
        возврат {
            "type": "string",
            "pattern": ШАБЛОН_ВРЕМЕНИ
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Длительность>)
        // Формат записи длительности в JSON документацией не описан
        возврат {
            "type": "string"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Байты>)
        возврат {
            "type": "string",
            "contentEncoding": "base64"
        }
    иначе если ТипДанных.МожетБытьПрисвоенВ(Тип<Перечисление>)
        возврат {
            "type": "string",
            "enum": ЗначенияПеречисления(ТипДанных)
        }
    ;
    возврат Неопределено
;

@Локально
метод ЗначенияПеречисления(ТипПеречисления: Тип<Объект?>): Массив<Строка>
    // Элементы() доступен только у типа перечисления, а конкретный тип известен лишь во время выполнения
    знч Элементы = (ТипПеречисления как неизвестно).Элементы() как ЧитаемыйМассив<Перечисление>
    возврат Элементы.Преобразовать(Элемент -> ИмяЭлементаВJson(Элемент))
;

// Имя элемента в JSON с учетом JsonЭлементПеречисления. Параметры аннотации через отражение недоступны,
// поэтому имя определяется сериализацией.
@Локально
метод ИмяЭлементаВJson(Элемент: Перечисление): Строка
    знч Json = СериализацияJson.ЗаписатьОбъект({
            "элемент": Элемент
        }, НастройкиЗаписиБезТипов())
    знч Данные = СериализацияJson.ПрочитатьОбъект(Json, Тип<Соответствие<Строка, Объект?>>)
    возврат Данные.Получить("элемент") как Строка
;

// Неопределено среди типов означает допустимость null
@Локально
метод СхемаТипов(Типы: ЧитаемоеМножество<Тип<Объект?>>, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч Варианты = Типы.Фильтровать(ТипДанных -> не ЭтоНеопределено(ТипДанных))
        .Преобразовать(ТипДанных -> СхемаТипа(ТипДанных, Контекст))
    знч Схема = Варианты.Размер() == 1 ? Варианты[0] :
        <Строка, Объект?>{
            "oneOf": Варианты
        }
    возврат ДопускаетNull(Типы) ? ДопускающаяNull(Схема) : Схема
;

@Локально
метод ДопускаетNull(Типы: ЧитаемоеМножество<Тип<Объект?>>): Булево
    возврат Типы.ЕстьСоответствия(ТипДанных -> ЭтоНеопределено(ТипДанных))
;

@Локально
метод ЭтоНеопределено(ТипДанных: Тип<Объект?>): Булево
    возврат ТипДанных.МожетБытьПрисвоенВ(Тип<Неопределено>)
;

// Перечень enum ограничивает значение независимо от type, поэтому null добавляется и в него.
// Пустая схема (Объект) null уже допускает.
@Локально
метод ДопускающаяNull(Схема: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    если Схема.Пусто()
        возврат Схема
    ;
    знч Перечень = Схема.ПолучитьИлиНеопределено("enum")
    если Перечень != Неопределено
        знч ПереченьСNull = <Объект?>[]
        ПереченьСNull.ДобавитьВсе(Перечень как ЧитаемыйМассив<Объект?>)
        ПереченьСNull.Добавить(Неопределено)
        Схема.Вставить("enum", ПереченьСNull)
    ;
    знч ТипJson = Схема.ПолучитьИлиНеопределено("type")
    если ТипJson это Строка
        Схема.Вставить("type", [ТипJson как Строка, "null"])
        возврат Схема
    ;
    возврат {
        "anyOf": [Схема,{
            "type": "null"
        }]}
;

// Схема модели строится один раз, при первом обращении
@Локально
метод СсылкаНаМодель(ТипДанных: Тип<Объект?>, Контекст: КонтекстПостроения): Соответствие<Строка, Объект?>
    знч Модель = Контекст.Модели.ПолучитьИлиНеопределено(ТипДанных.ВСтроку())
    если Модель == Неопределено
        знч Представление = ТипДанных.Представление()
        выбросить новый ИсключениеОписания(
            "Тип '%Представление' не поддерживается или не объявлен моделью OpenAPI: для структуры "
            + "добавьте OpenApi.Модель(Тип<%Представление>, \"Имя\") в Модели спецификации")
    ;
    если не Контекст.Схемы.СодержитКлюч(Модель.Имя)
        // Заглушка до построения схемы защищает от бесконечной рекурсии во взаимно ссылающихся структурах
        Контекст.Схемы.Вставить(Модель.Имя, Неопределено)
        Контекст.Схемы.Вставить(Модель.Имя, СхемаСтруктуры(ТипДанных, Модель, Контекст))
    ;
    возврат Ссылка(Модель.Имя)
;

@Локально
метод СхемаСтруктуры(
        ТипДанных: Тип<Объект?>,
        Модель: МодельOpenApi,
        Контекст: КонтекстПостроения
    ): Соответствие<Строка, Объект?>

    знч Свойства = <Строка, Объект?>{:}
    знч Обязательные = <Строка>[]
    знч Экземпляр = ЭкземплярМодели(ТипДанных)

    для Свойство из ТипДанных.ПолучитьСвойства().Фильтровать(Свойство -> не ИгнорируетсяВJson(Свойство))
        знч Имя = ИмяПоляВJson(Свойство, ТипДанных, Экземпляр)
        знч СхемаСвойства = СхемаТипов(Свойство.Типы, Контекст)
        ВставитьНеПустое(СхемаСвойства, "description", Модель.ОписанияПолей.ПолучитьИлиНеопределено(Имя))
        Свойства.Вставить(Имя, СхемаСвойства)
        если не ДопускаетNull(Свойство.Типы)
            Обязательные.Добавить(Имя)
        ;
    ;

    знч Json = СхемаОбъекта(Свойства, Обязательные)
    ВставитьНеПустое(Json, "description", Модель.Описание)
    возврат Json
;

@Локально
метод СхемаОбъекта(
        Свойства: Соответствие<Строка, Объект?>,
        Обязательные: ЧитаемыйМассив<Строка>
    ): Соответствие<Строка, Объект?>

    знч Json = <Строка, Объект?>{"type": "object", "properties": Свойства}
    если не Обязательные.Пусто()
        Json.Вставить("required", Обязательные)
    ;
    возврат Json
;

// Экземпляр со значениями по умолчанию нужен только для определения JSON-имен полей
@Локально
метод ЭкземплярМодели(ТипДанных: Тип<Объект?>): Объект
    попытка
        возврат ТипДанных.СоздатьЭкземпляр(<Объект?>[])!
    поймать Ошибка: ИсключениеОтражения
        выбросить новый ИсключениеОписания(
            "Не удалось создать экземпляр модели '%{ТипДанных.Представление()}' для определения JSON-имен полей: "
            + "у каждого поля должно быть значение по умолчанию, поле-структуру объявите как T? (%{Ошибка.Описание})",
            Ошибка)
    ;
;

// Имя поля в JSON. Параметры аннотации JsonСвойство через отражение недоступны, поэтому имя
// определяется сериализацией экземпляра, в которой оставлено только это поле.
@Локально
метод ИмяПоляВJson(
        Свойство: ОтражениеСвойства,
        ТипДанных: Тип<Объект?>,
        Экземпляр: Объект
    ): Строка

    знч ИмяСвойства = Свойство.Имя.ВСтроку()
    знч Настройки = НастройкиЗаписиБезТипов()
    Настройки.ИгнорируемыеСвойства.Вставить(
        ТипДанных,
        ТипДанных.ПолучитьСвойства()
            .Фильтровать(Поле -> Поле.Имя.ВСтроку() != ИмяСвойства)
            .Преобразовать(Поле -> Поле.Имя.ВСтроку())
            .ВоМножество())

    знч Json = СериализацияJson.ЗаписатьОбъект(Экземпляр, Настройки)
    знч Поля = СериализацияJson.ПрочитатьОбъект(
        Json, Тип<Соответствие<Строка, Объект?>>)

    если Поля.Размер() != 1
        выбросить новый ИсключениеОписания(
            "Не удалось определить JSON-имя поля %ИмяСвойства")
    ;
    возврат Поля.Ключи().Единственный()
;

// Запись всех значений без сведений о типе: по результату определяются имена в JSON
@Локально
метод НастройкиЗаписиБезТипов(): НастройкиЗаписиОбъектовJson
    знч Настройки = новый НастройкиЗаписиОбъектовJson()
    Настройки.ПропускатьНеопределено = Ложь
    Настройки.ПропускатьПустыеКоллекции = Ложь
    Настройки.РежимЗаписиТипа = РежимЗаписиТипаJson.НеЗаписывать
    возврат Настройки
;

@Локально
метод ИгнорируетсяВJson(Свойство: ОтражениеСвойства): Булево
    возврат Свойство.Аннотации.ЕстьСоответствия(Аннотация -> Аннотация это JsonИгнорироватьСвойство)
;

@Локально
метод СхемаProblem(): Соответствие<Строка, Объект?>
    возврат {
        "type": "object",
        "description": "Описание ошибки (RFC 9457)",
        "properties": {
            "type": {"type": "string", "description": "Идентификатор типа ошибки"},
            "title": {"type": "string", "description": "Краткое описание"},
            "status": {"type": "integer", "description": "HTTP-код ответа"},
            "detail": {"type": "string", "description": "Описание ошибки"},
            "instance": {"type": "string", "description": "Идентификатор случая ошибки"}
        }
    }
;

// Вспомогательные

@Локально
метод Параметр(
        Имя: Строка,
        Расположение: Строка,
        Описание: Строка,
        СхемаЗначения: СхемаOpenApi?,
        Обязательный: Булево
    ): ПараметрOpenApi

    возврат новый ПараметрOpenApi(
        Имя = Имя,
        Расположение = Расположение,
        Описание = Описание,
        Схема = СхемаЗначения ?? Схема(Тип<Строка>),
        Обязательный = Обязательный)
;

@Локально
метод ОписаниеОтвета(Код: Число, Описание: Строка): Строка
    знч ОписанияПоКоду = <Число, Строка>{
        200: "Успешный ответ",
        201: "Ресурс создан",
        202: "Запрос принят",
        204: "Успешно, без содержимого",
        400: "Некорректный запрос",
        401: "Требуется аутентификация",
        403: "Доступ запрещен",
        404: "Ресурс не найден",
        409: "Конфликт с текущим состоянием ресурса",
        422: "Ошибка проверки данных",
        500: "Внутренняя ошибка сервера"
    }
    возврат Описание.Пусто() ? (ОписанияПоКоду.ПолучитьИлиНеопределено(Код) ?? "Ответ %Код") : Описание
;

@Локально
метод Ссылка(ИмяМодели: Строка): Соответствие<Строка, Объект?>
    возврат {"\$ref": "#/components/schemas/" + ИмяМодели}
;

@Локально
метод ВставитьНеПустое(Json: Соответствие<Строка, Объект?>, Ключ: Строка, Значение: Строка?)
    если не (Значение ?? "").Пусто()
        Json.Вставить(Ключ, Значение)
    ;
;

